---
interface Props { lang?: string }
const { lang = 'de' } = Astro.props;
const year = 2026;
const base = import.meta.env.BASE_URL; // e.g. "/emoria/"
const prefix = lang === 'de' ? base : `${base}${lang}/`;

const FOOTER = {
  de: {
    tagline: 'Ein spielbasierter Weg für Kinder, ihre Gefühle zu erkennen, zu benennen und darüber zu sprechen. Yubuus Gefühlsrad ist der Anfang.',
    made: 'Made in Berlin · für Kindergärten, Schulen und Familien',
    home: 'Startseite', about: 'Über uns', contact: 'Kontakt', legal: 'Impressum',
    copy: (y: number) => `© ${y} EMORIA · Cemil Can Özkaya, Berlin. EMORIA startet im April 2027 in Kindergärten.`,
  },
  en: {
    tagline: 'A play-based way for children to recognise, name and talk about their feelings. Yubuu’s Feeling Wheel is where it begins.',
    made: 'Made in Berlin · for kindergartens, schools and families',
    home: 'Home', about: 'About us', contact: 'Contact', legal: 'Legal notice',
    copy: (y: number) => `© ${y} EMORIA · Cemil Can Özkaya, Berlin. EMORIA launches to kindergartens in April 2027.`,
  },
  fr: {
    tagline: 'Une manière ludique pour les enfants de reconnaître, nommer et exprimer leurs émotions. La roue des émotions de Yubuu, c\'est le début.',
    made: 'Conçu à Berlin · pour les crèches, écoles et familles',
    home: 'Accueil', about: 'À propos', contact: 'Contact', legal: 'Mentions légales',
    copy: (y: number) => `© ${y} EMORIA · Cemil Can Özkaya, Berlin. EMORIA sera lancé dans les crèches en avril 2027.`,
  },
  tr: {
    tagline: 'Çocukların duygularını tanıması, adlandırması ve bunlar hakkında konuşması için oyun tabanlı bir yol. Yubuu\'nun Duygu Çarkı başlangıcı.',
    made: 'Berlin\'de üretildi · anaokulları, okullar ve aileler için',
    home: 'Ana Sayfa', about: 'Hakkımızda', contact: 'İletişim', legal: 'Yasal Bilgiler',
    copy: (y: number) => `© ${y} EMORIA · Cemil Can Özkaya, Berlin. EMORIA, Nisan 2027'de anaokullarında başlıyor.`,
  },
};
const t = FOOTER[lang] ?? FOOTER.de;
---

<footer class="border-t border-[var(--color-cream-edge)] bg-[var(--color-cream-deep)]">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="font-[var(--font-display)] text-2xl font-semibold">EMORIA</p>
        <p class="mt-3 text-[var(--color-ink-soft)]">{t.tagline}</p>
        <p class="mt-4 text-sm text-[var(--color-ink-faint)]">{t.made}</p>
      </div>

      <nav class="flex flex-col gap-2 text-[var(--color-ink-soft)]">
        <a href={`${prefix}?nointro=1`} class="hover:text-[var(--color-ink)]">{t.home}</a>
        <a href={`${prefix}about`} class="hover:text-[var(--color-ink)]">{t.about}</a>
        {lang === 'de' && <a href={`${prefix}ueber-emoria`} class="hover:text-[var(--color-ink)]">Über EMORIA</a>}
        <a href={`${prefix}contact`} class="hover:text-[var(--color-ink)]">{t.contact}</a>
        <a href={`${prefix}legal`} class="hover:text-[var(--color-ink)]">{t.legal}</a>
      </nav>
    </div>

    <p class="mt-12 border-t border-[var(--color-cream-edge)] pt-6 text-sm text-[var(--color-ink-faint)]">
      {t.copy(year)}
    </p>
  </div>
</footer>
