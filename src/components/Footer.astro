---
const year = 2026;
const base = import.meta.env.BASE_URL; // e.g. "/emoria/"
---

<footer class="border-t border-[var(--color-cream-edge)] bg-[var(--color-cream-deep)]">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="font-[var(--font-display)] text-2xl font-semibold">EMORIA</p>
        <p class="mt-3 text-[var(--color-ink-soft)]">
          Ein spielbasierter Weg für Kinder, ihre Gefühle zu erkennen, zu benennen und darüber
          zu sprechen. Yubuus Gefühlsrad ist der Anfang.
        </p>
        <p class="mt-4 text-sm text-[var(--color-ink-faint)]">Made in Berlin · für Kindergärten, Schulen und Familien</p>
      </div>

      <nav class="flex flex-col gap-2 text-[var(--color-ink-soft)]">
        <a href={`${base}?nointro=1`} class="hover:text-[var(--color-ink)]">Startseite</a>
        <a href={`${base}about`} class="hover:text-[var(--color-ink)]">Über uns</a>
        <a href={`${base}contact`} class="hover:text-[var(--color-ink)]">Kontakt</a>
        <a href={`${base}legal`} class="hover:text-[var(--color-ink)]">Impressum</a>
      </nav>
    </div>

    <p class="mt-12 border-t border-[var(--color-cream-edge)] pt-6 text-sm text-[var(--color-ink-faint)]">
      © {year} EMORIA · Cemil Can Özkaya, Berlin. EMORIA startet im April 2027 in Kindergärten.
    </p>
  </div>
</footer>
