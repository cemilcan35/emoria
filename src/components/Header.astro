---
// Site header for inner pages — matches the accordion top menu.
interface Props { current?: string; lang?: string }
const { current = '', lang = 'de' } = Astro.props;
const base = import.meta.env.BASE_URL; // e.g. "/emoria/"
const prefix = lang === 'de' ? base : `${base}${lang}/`;

// Per-language nav labels + a couple of chrome strings. Add an entry here
// as each language's pages go live.
const NAV = {
  de: { home: 'Zur Startseite', kita: 'Kindergarten', schule: 'Schule', eltern: 'Eltern', about: 'Über uns', emoria: 'Über EMORIA', contact: 'Kontakt', langAria: 'Sprache wählen', prep: 'In Vorbereitung', menuOpen: 'Menü öffnen', menuClose: 'Menü schließen', langLabel: 'Sprache' },
  en: { home: 'Go to homepage', kita: 'Kindergarten', schule: 'School', eltern: 'Parents', about: 'About us', contact: 'Contact', langAria: 'Choose language', prep: 'Coming soon', menuOpen: 'Open menu', menuClose: 'Close menu', langLabel: 'Language' },
  fr: { home: "Aller à l'accueil", kita: 'Crèches', schule: 'Écoles', eltern: 'Parents', about: 'À propos', contact: 'Contact', langAria: 'Choisir la langue', prep: 'Bientôt disponible', menuOpen: 'Ouvrir le menu', menuClose: 'Fermer le menu', langLabel: 'Langue' },
  es: { home: 'Ir al inicio', kita: 'Guarderías', schule: 'Colegios', eltern: 'Familias', about: 'Sobre nosotros', contact: 'Contacto', langAria: 'Elegir idioma', prep: 'Próximamente', menuOpen: 'Abrir menú', menuClose: 'Cerrar menú', langLabel: 'Idioma' },
  tr: { home: 'Ana sayfaya git', kita: 'Anaokulu', schule: 'Okul', eltern: 'Aileler', about: 'Hakkımızda', contact: 'İletişim', langAria: 'Dil seçin', prep: 'Yakında', menuOpen: 'Menüyü aç', menuClose: 'Menüyü kapat', langLabel: 'Dil' },
};
const t = NAV[lang] ?? NAV.de;

const links = [
  { href: `${prefix}fuer-kindergaerten`, label: t.kita, icon: 'audience-kindergarten.png' },
  { href: `${prefix}fuer-schulen`, label: t.schule, icon: 'audience-schule.png' },
  { href: `${prefix}fuer-eltern`, label: t.eltern, icon: 'audience-eltern.png' },
  { href: `${prefix}about`, label: t.about },
  ...(lang === 'de' ? [{ href: `${prefix}ueber-emoria`, label: t.emoria }] : []),
  { href: `${prefix}contact`, label: t.contact },
];

// Language switcher. `ready: true` languages link to their translated
// section; the rest are shown but disabled until that translation exists,
// so the menu never points to a missing page.
const languages = [
  { code: 'DE', label: 'Deutsch', href: `${base}?nointro=1`, ready: true },
  { code: 'EN', label: 'English', href: `${base}en/`, ready: true },
  { code: 'FR', label: 'Français', href: `${base}fr/`, ready: true },
  { code: 'ES', label: 'Español', href: `${base}es/`, ready: false },
  { code: 'TR', label: 'Türkçe', href: `${base}tr/`, ready: true },
  { code: 'DA', label: 'Dansk', href: `${base}da/`, ready: false },
  { code: 'SV', label: 'Svenska', href: `${base}sv/`, ready: false },
  { code: 'NO', label: 'Norsk', href: `${base}no/`, ready: false },
  { code: 'FI', label: 'Suomi', href: `${base}fi/`, ready: false },
];
---

<header class="absolute inset-x-0 top-0 z-50">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href={`${prefix}?nointro=1`} class="font-[var(--font-display)] text-2xl font-semibold tracking-wide text-[var(--color-ink)]" aria-label={t.home}>
      EMORIA
    </a>
    <ul class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'flex items-center gap-2 font-[var(--font-body)] text-[15px] font-medium text-[var(--color-ink)] transition',
              current === l.label ? 'opacity-100' : 'opacity-75 hover:opacity-100',
            ]}
          >
            {l.icon && <img src={`${base}img/${l.icon}`} alt="" aria-hidden="true" class="h-[50px] w-[50px] rounded-2xl object-cover shadow-sm" />}
            {l.label}
          </a>
        </li>
      ))}
      <li class="group relative">
        <button type="button" class="flex items-center gap-1 font-[var(--font-body)] text-[15px] font-medium text-[var(--color-ink)] opacity-75 transition hover:opacity-100" aria-label={t.langAria}>
          🌐 {lang.toUpperCase()}
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="mt-px" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
        </button>
        <ul class="invisible absolute right-0 top-full z-10 mt-2 w-40 -translate-y-1 rounded-[var(--radius-card)] border border-[var(--color-cream-edge)] bg-white p-2 opacity-0 shadow-[var(--shadow-lift)] transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          {languages.map((lg) => (
            lg.ready ? (
              <li>
                <a href={lg.href} class="flex items-center justify-between rounded-lg px-3 py-2 font-[var(--font-body)] text-[14px] text-[var(--color-ink)] transition hover:bg-[var(--color-cream)]">
                  <span>{lg.label}</span>
                  <span class="text-[var(--color-ink-faint)]">{lg.code}</span>
                </a>
              </li>
            ) : (
              <li class="flex cursor-not-allowed items-center justify-between rounded-lg px-3 py-2 font-[var(--font-body)] text-[14px] text-[var(--color-ink-faint)]" title={t.prep}>
                <span>{lg.label}</span>
                <span>{lg.code}</span>
              </li>
            )
          ))}
        </ul>
      </li>
    </ul>

    <button type="button" class="flex h-11 w-11 flex-shrink-0 flex-col items-center justify-center gap-[5px] border-0 bg-transparent md:hidden" data-header-menu-toggle aria-label={t.menuOpen} aria-expanded="false" aria-controls="headerDrawer">
      <span class="block h-[2px] w-[22px] rounded-full bg-[var(--color-ink)]"></span>
      <span class="block h-[2px] w-[22px] rounded-full bg-[var(--color-ink)]"></span>
      <span class="block h-[2px] w-[22px] rounded-full bg-[var(--color-ink)]"></span>
    </button>
  </nav>
</header>

<div class="fixed inset-0 z-[90] invisible" data-header-drawer id="headerDrawer" aria-hidden="true">
  <div class="absolute inset-0 bg-[var(--color-ink)]/45 opacity-0 transition-opacity duration-300" data-header-drawer-backdrop></div>
  <nav
    class="absolute right-0 top-0 flex h-full w-[min(82vw,320px)] translate-x-full flex-col gap-1 overflow-y-auto bg-[var(--color-cream)] px-6 pb-8 pt-20 shadow-[-12px_0_40px_rgba(43,42,40,0.18)] transition-transform duration-300"
    data-header-drawer-panel
    aria-label={t.langAria}
  >
    <button type="button" class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center border-0 bg-transparent text-xl text-[var(--color-ink)]" data-header-drawer-close aria-label={t.menuClose}>✕</button>
    {links.map((l) => (
      <a href={l.href} class="flex min-h-11 items-center gap-3 border-b border-[var(--color-cream-edge)] py-3 font-[var(--font-display)] text-lg font-semibold text-[var(--color-ink)]">
        {l.icon && <img src={`${base}img/${l.icon}`} alt="" aria-hidden="true" class="h-[68px] w-[68px] rounded-[18px] object-cover shadow-sm" />}
        {l.label}
      </a>
    ))}
    <div class="mt-5 flex flex-col gap-1">
      <p class="mb-1 text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-faint)]">{t.langLabel}</p>
      {languages.filter((lg) => lg.ready).map((lg) => (
        <a href={lg.href} class="flex min-h-11 items-center justify-between py-2 font-[var(--font-body)] text-base font-medium text-[var(--color-ink)]">
          <span>{lg.label}</span>
          <span class="text-[var(--color-ink-faint)]">{lg.code}</span>
        </a>
      ))}
    </div>
  </nav>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-header-menu-toggle]').forEach((menuBtn) => {
      const drawer = document.querySelector('[data-header-drawer]');
      if (!drawer) return;
      const backdrop = drawer.querySelector('[data-header-drawer-backdrop]');
      const panel = drawer.querySelector('[data-header-drawer-panel]');
      const closeBtn = drawer.querySelector('[data-header-drawer-close]');

      function open() {
        drawer.classList.remove('invisible');
        drawer.setAttribute('aria-hidden', 'false');
        menuBtn.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => {
          backdrop.classList.remove('opacity-0');
          panel.classList.remove('translate-x-full');
        });
        document.body.classList.add('overflow-hidden');
      }
      function close() {
        backdrop.classList.add('opacity-0');
        panel.classList.add('translate-x-full');
        menuBtn.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => {
          drawer.classList.add('invisible');
          drawer.setAttribute('aria-hidden', 'true');
        }, 300);
      }
      menuBtn.addEventListener('click', open);
      closeBtn?.addEventListener('click', close);
      backdrop?.addEventListener('click', close);
      drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.classList.contains('invisible')) close();
      });
    });
  })();
</script>
