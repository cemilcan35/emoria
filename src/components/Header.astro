---
// Site header for inner pages. Deliberately the homepage's top row and nothing
// else: brand lockup left, the quiet secondary links right. The three audience
// entries (Kindergarten / Schule / Eltern) live on the homepage only.
interface Props { current?: string; lang?: string }
const { current = '', lang = 'de' } = Astro.props;
const base = import.meta.env.BASE_URL; // e.g. "/emoria/"
const prefix = lang === 'de' ? base : `${base}${lang}/`;

const NAV = {
  de: { home: 'Zur Startseite', about: 'Über uns', emoria: 'Über EMORIA', contact: 'Kontakt', langAria: 'Sprache wählen', prep: 'In Vorbereitung',
        groups: 'Zielgruppe', kita: 'Kindergarten', schule: 'Schule', logo: 'Logopädie', psych: 'Kinderpsychologie', eltern: 'Eltern' },
  en: { home: 'Go to homepage', about: 'About us', contact: 'Contact', langAria: 'Choose language', prep: 'Coming soon',
        groups: 'Who it is for', kita: 'Kindergarten', schule: 'School', eltern: 'Parents' },
  fr: { home: "Aller à l'accueil", about: 'À propos', contact: 'Contact', langAria: 'Choisir la langue', prep: 'Bientôt disponible',
        groups: 'Pour qui', kita: 'Crèches', schule: 'Écoles', eltern: 'Parents' },
  es: { home: 'Ir al inicio', about: 'Sobre nosotros', contact: 'Contacto', langAria: 'Elegir idioma', prep: 'Próximamente',
        groups: 'Para quién', kita: 'Guarderías', schule: 'Colegios', eltern: 'Familias' },
  tr: { home: 'Ana sayfaya git', about: 'Hakkımızda', contact: 'İletişim', langAria: 'Dil seçin', prep: 'Yakında',
        groups: 'Hedef kitle', kita: 'Anaokulu', schule: 'Okul', eltern: 'Aileler' },
};
const t = NAV[lang] ?? NAV.de;

// the audience pages live behind one "Zielgruppe" entry now — Logopädie and
// Kinderpsychologie exist in German only so far
const audience = [
  { href: `${prefix}fuer-kindergaerten`, label: t.kita, icon: 'audience-kindergarten.png' },
  { href: `${prefix}fuer-schulen`, label: t.schule, icon: 'audience-schule.png' },
  ...(lang === 'de' ? [
    { href: `${prefix}fuer-logopaedie`, label: t.logo, icon: 'audience-logopaedie.png' },
    { href: `${prefix}fuer-kinderpsychologie`, label: t.psych, icon: 'audience-kinderpsychologie.png' },
  ] : []),
  { href: `${prefix}fuer-eltern`, label: t.eltern, icon: 'audience-eltern.png' },
];

const links = [
  { href: `${prefix}about`, label: t.about },
  ...(lang === 'de' ? [{ href: `${prefix}ueber-emoria`, label: t.emoria }] : []),
  { href: `${prefix}contact`, label: t.contact },
];

const inAudience = audience.some((a) => a.label === current);

// `ready: true` languages link to their translated section; the rest are shown
// but disabled until that translation exists.
const languages = [
  { code: 'DE', label: 'Deutsch', href: `${base}?nointro=1`, ready: true },
  { code: 'EN', label: 'English', href: `${base}en/`, ready: true },
  { code: 'FR', label: 'Français', href: `${base}fr/`, ready: true },
  { code: 'ES', label: 'Español', href: `${base}es/`, ready: false },
  { code: 'TR', label: 'Türkçe', href: `${base}tr/`, ready: true },
  { code: 'DA', label: 'Dansk', href: `${base}da/`, ready: false },
  { code: 'SV', label: 'Svenska', href: `${base}sv/`, ready: false },
  { code: 'NO', label: 'Norsk', href: `${base}no/`, ready: false },
  { code: 'FI', label: 'Suomi', href: `${base}fi/`, ready: false },
];
---

<header class="site-head">
  <a class="brand" href={`${prefix}?nointro=1`} aria-label={t.home}>
    <span class="brand-name">EMORIA</span>
    <span class="brand-sub">Social and Emotional Learning</span>
  </a>

  <nav class="head-nav" aria-label={t.groups}>
    <div class="aud-switch">
      <button type="button" class:list={['aud-trigger', inAudience && 'is-current']} aria-haspopup="true" aria-expanded="false">
        {t.groups}
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </button>
      <ul class="aud-menu">
        {audience.map((a) => (
          <li>
            <a href={a.href} class:list={[current === a.label && 'is-current']}>
              <img src={`${base}img/${a.icon}`} alt="" aria-hidden="true" />
              <span>{a.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    {links.map((l) => (
      <a href={l.href} class:list={[current === l.label && 'is-current']}>{l.label}</a>
    ))}
    <div class="lang-switch">
      <button type="button" class="lang-trigger" aria-label={t.langAria}>🌐 {lang.toUpperCase()}</button>
      <ul class="lang-menu">
        {languages.map((lg) => (
          lg.ready ? (
            <li><a href={lg.href}><span>{lg.label}</span><span class="code">{lg.code}</span></a></li>
          ) : (
            <li class="disabled" title={t.prep}><span>{lg.label}</span><span class="code">{lg.code}</span></li>
          )
        ))}
      </ul>
    </div>
  </nav>
</header>

<style is:global>
  .site-head { position: absolute; inset-inline: 0; top: 0; z-index: 50;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
    padding: 10px clamp(1.2rem, 2.6vw, 2.2rem) 0; }

  .site-head .brand { text-decoration: none; color: var(--color-ink);
    display: flex; flex-direction: column; align-items: flex-start; line-height: 1.05; }
  .site-head .brand-name { font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: .02em; }
  .site-head .brand-sub { font-family: var(--font-body); font-weight: 500; font-size: 10.5px;
    letter-spacing: .07em; text-transform: uppercase; color: var(--color-ink-faint); margin-top: 3px;
    white-space: nowrap; }

  .site-head .head-nav { display: flex; align-items: center; gap: 1rem; }
  .site-head .head-nav > a {
    font-family: var(--font-body); font-weight: 500; font-size: 13px; color: var(--color-ink);
    text-decoration: none; opacity: .78; transition: opacity .2s, border-color .2s;
    display: inline-flex; align-items: center; min-height: 34px;
    border-bottom: 2px solid rgba(255,118,115,.55); padding-bottom: 1px; }
  .site-head .head-nav > a:hover { opacity: 1; border-bottom-color: var(--color-brand); }
  .site-head .head-nav > a.is-current { opacity: 1; border-bottom-color: var(--color-brand); }

  /* Zielgruppe: one entry that drops the five audience pages down on hover */
  .site-head .aud-switch { position: relative; }
  .site-head .aud-trigger { display: inline-flex; align-items: center; gap: 5px; background: none;
    border: 0; border-bottom: 2px solid rgba(255,118,115,.55); padding: 0 0 1px; cursor: pointer;
    font-family: var(--font-body); font-weight: 500; font-size: 13px; color: var(--color-ink);
    opacity: .78; min-height: 34px; transition: opacity .2s, border-color .2s; }
  .site-head .aud-switch:hover .aud-trigger,
  .site-head .aud-trigger.is-current { opacity: 1; border-bottom-color: var(--color-brand); }
  .site-head .aud-menu { position: absolute; left: 50%; transform: translate(-50%, -4px); top: calc(100% + 8px);
    z-index: 10; margin: 0; list-style: none; width: 15rem; padding: .4rem; border-radius: 16px;
    background: #fff; border: 1px solid var(--color-cream-edge); box-shadow: var(--shadow-lift);
    opacity: 0; visibility: hidden;
    transition: opacity .18s ease, transform .18s ease, visibility .18s; }
  .site-head .aud-switch:hover .aud-menu,
  .site-head .aud-switch:focus-within .aud-menu { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .site-head .aud-menu a { display: flex; align-items: center; gap: .65rem; padding: .45rem .55rem;
    border-radius: 11px; text-decoration: none; color: var(--color-ink);
    font-family: var(--font-body); font-size: 14px; font-weight: 500; }
  .site-head .aud-menu a:hover { background: var(--color-cream); }
  .site-head .aud-menu a.is-current { background: var(--color-cream); font-weight: 600; }
  .site-head .aud-menu img { width: 34px; height: 34px; border-radius: 10px; object-fit: cover; flex: none;
    box-shadow: 0 1px 4px rgba(43,42,40,.18); }

  .site-head .lang-switch { position: relative; }
  .site-head .lang-trigger { background: none; border: 0; cursor: pointer; font-family: var(--font-body);
    font-weight: 500; font-size: 13px; color: var(--color-ink); opacity: .78; min-height: 34px; padding: 0;
    transition: opacity .2s; }
  .site-head .lang-trigger:hover { opacity: 1; }
  .site-head .lang-menu { position: absolute; right: 0; top: calc(100% + 8px); z-index: 10; margin: 0;
    list-style: none; width: 10.5rem; padding: .4rem; border-radius: 14px;
    background: #fff; border: 1px solid var(--color-cream-edge); box-shadow: var(--shadow-lift);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s; }
  .site-head .lang-switch:hover .lang-menu,
  .site-head .lang-switch:focus-within .lang-menu { opacity: 1; visibility: visible; transform: none; }
  .site-head .lang-menu li { display: flex; align-items: center; justify-content: space-between;
    padding: .5rem .7rem; border-radius: 8px; font-family: var(--font-body); font-size: 14px; }
  .site-head .lang-menu a { display: flex; width: 100%; align-items: center; justify-content: space-between;
    color: var(--color-ink); text-decoration: none; }
  .site-head .lang-menu .code { color: var(--color-ink-faint); }
  .site-head .lang-menu li:not(.disabled):hover { background: var(--color-cream); }
  .site-head .lang-menu li.disabled { color: var(--color-ink-faint); cursor: not-allowed; }

  @media (max-width: 640px) {
    .site-head { padding: 8px .8rem 0; }
    .site-head .brand-name { font-size: 18px; }
    .site-head .brand-sub { font-size: 8.5px; letter-spacing: .04em; white-space: normal; max-width: 15ch; }
    .site-head .head-nav { gap: .7rem; }
    .site-head .head-nav > a, .site-head .lang-trigger, .site-head .aud-trigger { font-size: 11.5px; min-height: 30px; }
    .site-head .aud-menu { width: 13.5rem; }
  }
  @media (max-width: 380px) {
    .site-head .head-nav { gap: .5rem; }
    .site-head .head-nav > a, .site-head .lang-trigger, .site-head .aud-trigger { font-size: 10.5px; white-space: nowrap; }
    .site-head .brand-name { font-size: 16px; }
    .site-head .brand-sub { font-size: 8.5px; letter-spacing: .05em; }
  }
</style>
