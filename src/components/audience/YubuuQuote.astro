---
interface Props { quote: string; image?: string; imageAlt?: string }
const { quote, image = 'yubuu-rocket.png', imageAlt = 'Yubuu' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="mx-auto flex max-w-3xl flex-col items-center gap-4 px-6 py-14 text-center">
  <img src={`${base}img/${image}`} alt={imageAlt} class="h-24 w-auto drop-shadow-[0_10px_18px_rgba(43,42,40,0.14)]" />
  <p class="font-serif-heading text-xl italic leading-relaxed text-[var(--color-ink)] sm:text-2xl">
    „{quote}"
  </p>
  <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-terracotta)]">— Yubuu</p>
</section>
