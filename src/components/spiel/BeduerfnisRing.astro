---
// Drehender Ring aus den 14 Bedürfniskreisen (nur Desktop).
// Auf dem Handy, mit reduzierter Bewegung und ohne JavaScript zeigt die Seite stattdessen das ruhige Standbild.
import type { RingText } from '../../data/spiel';

interface Props { text: RingText; staticSrc: string; staticAlt: string }
const { text: R, staticSrc, staticAlt } = Astro.props;
const base = import.meta.env.BASE_URL;

// Beschriftung steht im Bild; hier nur für Screenreader
const ITEMS = [
  ['Bewegen', '01-bewegen'], ['Draußen sein', '02-draussen-sein'], ['Rückzug', '03-rueckzug'],
  ['Jemand hört mir zu', '04-jemand-hoert-zu'], ['Malen', '05-malen'], ['Musik hören', '06-musik-hoeren'],
  ['Reden', '07-reden'], ['Ruhe', '08-ruhe'], ['Weinen dürfen', '09-weinen-duerfen'],
  ['Umarmung', '10-umarmung'], ['Teilen', '11-teilen'], ['Spazieren', '12-spazieren'],
  ['Schlafen', '13-schlafen'], ['Geborgenheit', '14-geborgenheit'],
].map(([label, file]) => ({ label, src: `${base}img/spielablauf/ring/${file}.webp` }));

const SPARKS = [[18, 9, 14], [30, 4, 9], [72, 6, 12], [86, 12, 16], [94, 30, 10], [6, 40, 8], [90, 52, 9], [12, 70, 11], [96, 74, 13], [40, 96, 9], [62, 3, 8], [52, 92, 7]];
---

<div class="ring-wrap" data-ring-wrap data-items={JSON.stringify(ITEMS)} data-front={R.front}>
  <img class="ring-static" src={staticSrc} alt={staticAlt} width="1600" height="1200" loading="lazy" decoding="async" />

  <div class="ring" data-ring>
    <div class="ring-stage" data-ring-stage role="group" aria-roledescription={R.role} aria-label={R.label}>
      <div class="ring-deco" aria-hidden="true">
        <svg width="0" height="0" style="position:absolute"><defs>
          <g id="ring-sprig" stroke-width="2"><path d="M100 196C98 140 104 80 128 14" fill="none"/>
            <ellipse rx="13" ry="30" transform="translate(84 150) rotate(-40)"/><ellipse rx="13" ry="30" transform="translate(120 136) rotate(40)"/>
            <ellipse rx="12" ry="27" transform="translate(88 104) rotate(-35)"/><ellipse rx="12" ry="27" transform="translate(124 88) rotate(42)"/>
            <ellipse rx="11" ry="24" transform="translate(100 58) rotate(-30)"/><ellipse rx="10" ry="22" transform="translate(134 40) rotate(40)"/></g>
          <path id="ring-star" d="M10 0C11 6 14 9 20 10C14 11 11 14 10 20C9 14 6 11 0 10C6 9 9 6 10 0Z"/></defs></svg>
        <svg class="ring-leaf" style="left:-1%;top:4%;transform:rotate(-20deg)" viewBox="0 0 200 200"><use href="#ring-sprig" fill="#c5b3dc" stroke="#b39fd0"/></svg>
        <svg class="ring-leaf" style="left:-2%;bottom:-3%;transform:rotate(10deg)" viewBox="0 0 200 200"><use href="#ring-sprig" fill="#cdbce3" stroke="#b7a3d6"/></svg>
        <svg class="ring-leaf" style="left:10%;bottom:-6%;transform:rotate(-35deg) scale(.8)" viewBox="0 0 200 200"><use href="#ring-sprig" fill="#d6e3b8" stroke="#bfd29a"/></svg>
        <svg class="ring-leaf" style="right:-2%;bottom:-4%;transform:scaleX(-1) rotate(5deg)" viewBox="0 0 200 200"><use href="#ring-sprig" fill="#d3e2b4" stroke="#bccf98"/></svg>
        {SPARKS.map(([x, y, s], i) => (
          <svg class="ring-spark" viewBox="0 0 20 20" style={`left:${x}%;top:${y}%;--s:${s}px;--d:${(-i * 0.7).toFixed(1)}s`}><use href="#ring-star"/></svg>
        ))}
      </div>
      <div class="ring-center" data-ring-center>
        <p class="ring-title">{R.title}</p>
        <p class="ring-sub">{R.sub}</p>
      </div>
    </div>
    <div class="ring-ctrl">
      <button type="button" data-ring-prev aria-label={R.prev}>‹</button>
      <button type="button" data-ring-play aria-pressed="false" data-pause={R.pause} data-spin={R.play}>{R.pause}</button>
      <button type="button" data-ring-next aria-label={R.next}>›</button>
      <span class="ring-hint">{R.hint}</span>
    </div>
    <div class="ring-sr" aria-live="polite" data-ring-live></div>
  </div>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-ring-wrap]');
  if (wrap) {
    const mq = matchMedia('(max-width: 640px), (prefers-reduced-motion: reduce)');
    const stage = wrap.querySelector<HTMLElement>('[data-ring-stage]')!;
    const centerEl = wrap.querySelector<HTMLElement>('[data-ring-center]')!;
    const live = wrap.querySelector<HTMLElement>('[data-ring-live]')!;
    const playBtn = wrap.querySelector<HTMLButtonElement>('[data-ring-play]')!;
    const DATA: { label: string; src: string }[] = JSON.parse(wrap.dataset.items || '[]');
    const FRONT = wrap.dataset.front || '';
    const N = DATA.length, STEP = Math.PI * 2 / N;
    const SPEED = STEP / 4.2; // ca. 60 Sekunden pro Runde
    const START = Math.PI * 1.08; // "Bewegen" links oben
    let els: HTMLElement[] = [];
    let rot = 0, vel = 0, target: number | null = null, auto = true, W = 0, H = 0;
    let geo = { cx: 0, cy: 0, rx: 0, ry: 0, size: 0 };
    let running = false, visible = false, hover = false, last = 0, moved = 0;
    let drag: { x: number; t: number; v: number } | null = null;
    let built = false;

    function build() {
      built = true;
      els = DATA.map((s, i) => {
        const b = document.createElement('div');
        b.className = 'ring-badge'; b.tabIndex = 0; b.setAttribute('role', 'button'); b.setAttribute('aria-label', s.label);
        b.innerHTML = `<img src="${s.src}" alt="" draggable="false" width="360" height="360" decoding="async">`;
        b.dataset.i = String(i); stage.appendChild(b);
        b.addEventListener('pointerenter', () => { hover = true; });
        b.addEventListener('pointerleave', () => { hover = false; });
        b.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); bringToFront(i); } });
        return b;
      });
    }
    function measure() {
      W = stage.clientWidth; H = stage.clientHeight;
      const narrow = W / H < 1.2;
      geo = narrow
        ? { cx: W * .5, cy: H * .5, rx: W * .37, ry: H * .39, size: W * .235 }
        : { cx: W * .5, cy: H * .47, rx: W * .415, ry: H * .345, size: W * .158 };
      stage.style.setProperty('--size', geo.size + 'px');
      centerEl.style.setProperty('--cy', (geo.cy / H * 100) + '%');
    }
    function draw() {
      els.forEach((el, i) => {
        const a = START + i * STEP + rot, s = Math.sin(a), c = Math.cos(a);
        const k = .63 + .37 * (s + 1) / 2;
        const x = geo.cx + geo.rx * c - geo.size / 2, y = geo.cy + geo.ry * s - geo.size / 2;
        el.style.transform = `translate(${x.toFixed(1)}px,${y.toFixed(1)}px) scale(${k.toFixed(3)})`;
        el.style.zIndex = String(Math.round(100 + s * 40));
      });
    }
    function frontIndex() {
      let best = 0, bv = -2;
      els.forEach((_, i) => { const s = Math.sin(START + i * STEP + rot); if (s > bv) { bv = s; best = i; } });
      return best;
    }
    function announce() { live.textContent = FRONT + DATA[frontIndex()].label; }
    function bringToFront(i: number) {
      const want = Math.PI / 2 - (START + i * STEP);
      let d = want - rot; d = ((d % (2 * Math.PI)) + 3 * Math.PI) % (2 * Math.PI) - Math.PI;
      target = rot + d; vel = 0;
      els.forEach((e, j) => e.classList.toggle('on', j === i));
      kick();
    }
    function step(dir: number) { bringToFront((frontIndex() + dir + N) % N); }

    function tick(t: number) {
      if (!running) return;
      const dt = Math.min(.05, (t - last) / 1000); last = t;
      if (target !== null) {
        const d = target - rot; rot += d * Math.min(1, dt * 5);
        if (Math.abs(d) < .0008) { rot = target; target = null; announce(); }
      } else if (!drag) {
        if (Math.abs(vel) > .002) { rot += vel * dt; vel *= Math.pow(.05, dt); }
        else { vel = 0; if (auto && !hover) rot += SPEED * dt; }
      }
      draw();
      requestAnimationFrame(tick);
    }
    // Läuft nur, wenn der Ring sichtbar und aktiv ist
    function kick() {
      if (running || !visible || !wrap!.classList.contains('is-live') || document.hidden) return;
      running = true; last = performance.now(); requestAnimationFrame(tick);
    }
    function halt() { running = false; }

    // Ziehen und Antippen
    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      drag = { x: e.clientX, t: performance.now(), v: 0 }; moved = 0; target = null;
      stage.classList.add('grab'); stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x, now = performance.now(); moved += Math.abs(dx);
      const dr = -dx / (geo.rx || 1) * .9; rot += dr;
      drag.v = dr / Math.max(.008, (now - drag.t) / 1000); drag.x = e.clientX; drag.t = now;
    });
    const up = (e: PointerEvent) => {
      if (!drag) return;
      stage.classList.remove('grab');
      if (moved < 6) {
        const el = document.elementsFromPoint(e.clientX, e.clientY).find((n) => n.classList && n.classList.contains('ring-badge')) as HTMLElement | undefined;
        if (el) bringToFront(Number(el.dataset.i));
      } else vel = Math.max(-6, Math.min(6, drag.v));
      drag = null;
    };
    stage.addEventListener('pointerup', up); stage.addEventListener('pointercancel', up);
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    });
    wrap.querySelector<HTMLButtonElement>('[data-ring-prev]')!.onclick = () => step(-1);
    wrap.querySelector<HTMLButtonElement>('[data-ring-next]')!.onclick = () => step(1);
    const setPlay = () => {
      playBtn.textContent = auto ? (playBtn.dataset.pause || '') : (playBtn.dataset.spin || '');
      playBtn.setAttribute('aria-pressed', String(!auto));
    };
    playBtn.onclick = () => { auto = !auto; setPlay(); kick(); };
    setPlay();

    new ResizeObserver(() => { if (built) { measure(); draw(); } }).observe(stage);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) kick(); else halt();
    }).observe(wrap);
    document.addEventListener('visibilitychange', () => { if (document.hidden) halt(); else kick(); });

    // Nur auf großen Bildschirmen ohne reduzierte Bewegung anschalten
    function sync() {
      if (mq.matches) { halt(); wrap!.classList.remove('is-live'); return; }
      if (!built) build();
      wrap!.classList.add('is-live');
      measure(); draw(); kick();
    }
    mq.addEventListener('change', sync);
    sync();
  }
</script>

<style is:global>
  .ring-wrap { --ring-plum: #5b2350; --ring-plum2: #6d3463; position: relative; width: 100%; border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--shadow-soft); background: var(--color-cream-deep); }
  .ring-wrap .ring-static { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; }
  .ring-wrap .ring { display: none; }
  .ring-wrap.is-live { background:
      radial-gradient(60% 55% at 12% 8%, #e9dcf5 0, transparent 70%),
      radial-gradient(55% 50% at 92% 10%, #f6dcea 0, transparent 70%),
      radial-gradient(60% 55% at 50% 55%, #fdf1ea 0, transparent 75%),
      radial-gradient(50% 45% at 8% 95%, #e3eedc 0, transparent 70%),
      radial-gradient(50% 45% at 95% 95%, #e8f1dd 0, transparent 70%),
      #f9ecf0; }
  .ring-wrap.is-live .ring { display: block; padding: clamp(6px, 1.2vw, 14px) clamp(6px, 1.2vw, 14px) clamp(12px, 1.6vw, 18px); }
  .ring-wrap.is-live .ring-static { display: none; }
  @media (min-width: 641px) { .ring-wrap:not(.is-live) .ring-static { aspect-ratio: 3 / 2; } }

  .ring-stage { position: relative; width: 100%; aspect-ratio: 3 / 2; container-type: inline-size; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .ring-stage.grab { cursor: grabbing; }
  .ring-deco { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .ring-leaf { position: absolute; width: clamp(70px, 16cqw, 200px); opacity: .75; }
  .ring-spark { position: absolute; width: var(--s); fill: #fff; opacity: .9; animation: ring-tw 3.6s ease-in-out var(--d) infinite alternate; filter: drop-shadow(0 0 4px rgba(255,255,255,.9)); }
  @keyframes ring-tw { to { opacity: .25; transform: scale(.7); } }
  .ring-center { position: absolute; left: 50%; top: var(--cy, 46%); transform: translate(-50%, -50%); text-align: center; width: min(62%, 560px); pointer-events: none; z-index: 50; }
  .ring-title { margin: 0 0 .35em; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.2rem, 4.2cqw, 2.6rem); line-height: 1.08; color: var(--ring-plum); text-wrap: balance; text-shadow: 0 2px 0 rgba(255,255,255,.7); }
  .ring-sub { margin: 0; font-family: var(--font-body); font-weight: 500; font-size: clamp(.85rem, 2cqw, 1.2rem); color: var(--ring-plum2); }
  .ring-badge { position: absolute; left: 0; top: 0; width: var(--size); aspect-ratio: 1; border-radius: 50%; will-change: transform; cursor: pointer; outline: none; }
  .ring-badge img { width: 100%; height: 100%; display: block; border-radius: 50%; pointer-events: none; filter: drop-shadow(0 8px 14px rgba(110,60,110,.22)); transition: transform .35s cubic-bezier(.2,.9,.3,1.3), filter .35s; }
  .ring-badge:hover img, .ring-badge:focus-visible img { transform: scale(1.07); }
  .ring-badge:focus-visible img { filter: drop-shadow(0 0 0 #fff) drop-shadow(0 0 12px #c9a4e6); }
  .ring-badge.on img { transform: scale(1.1); filter: drop-shadow(0 0 0 #fff) drop-shadow(0 0 18px rgba(255,255,255,.95)) drop-shadow(0 10px 18px rgba(110,60,110,.3)); }
  .ring-ctrl { display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: clamp(4px, 1vw, 10px); }
  .ring-ctrl button { font-family: var(--font-body); font-size: 16px; font-weight: 600; color: var(--ring-plum); background: rgba(255,255,255,.75); border: 1.5px solid #ead6e8; border-radius: 99px; min-width: 44px; min-height: 44px; padding: .5rem 1.05rem; cursor: pointer; transition: transform .2s, border-color .2s; }
  .ring-ctrl button:hover { transform: translateY(-2px); border-color: #c9a4e6; }
  .ring-ctrl button:focus-visible { outline: 3px solid #c9a4e6; outline-offset: 3px; }
  .ring-hint { flex-basis: 100%; text-align: center; margin-top: 2px; font-family: var(--font-body); font-size: 14px; color: var(--ring-plum2); opacity: .8; }
  .ring-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
