---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/rubik';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  overlayHeader?: boolean;
  hideChrome?: boolean;
  lang?: string;
}

const DEFAULTS = {
  de: {
    title: 'EMORIA — Emotionales Lernen',
    description: 'EMORIA ist ein spielbasiertes System, das Kindern hilft, ihre Gefühle zu erkennen, zu benennen und darüber zu sprechen. Yubuus Gefühlsrad ist der Anfang.',
  },
  en: {
    title: 'EMORIA — Emotional Learning',
    description: "EMORIA is a play-based system that helps children recognise, name and talk about their feelings. Yubuu's Feeling Wheel is where it begins.",
  },
  fr: {
    title: 'EMORIA — Apprentissage émotionnel',
    description: "EMORIA est un système ludique qui aide les enfants à reconnaître, nommer et exprimer leurs émotions. La roue des émotions de Yubuu, c'est le début.",
  },
};

const {
  lang = 'de',
  title = DEFAULTS[lang]?.title ?? DEFAULTS.de.title,
  description = DEFAULTS[lang]?.description ?? DEFAULTS.de.description,
  current = '',
  overlayHeader = false,
  hideChrome = false,
} = Astro.props;
const base = import.meta.env.BASE_URL; // e.g. "/emoria/"
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={`${base}img/logo.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    {!hideChrome && <Header overlay={overlayHeader} current={current} lang={lang} />}
    <main>
      <slot />
    </main>
    {!hideChrome && <Footer lang={lang} />}
  </body>
</html>
