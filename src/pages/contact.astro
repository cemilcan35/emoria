---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Kontakt — EMORIA" current="Kontakt"
  description="Interesse, EMORIA in Ihre Kita zu bringen, oder möchten Sie auf dem Laufenden bleiben? Schreiben Sie Cemil.">
  <article class="bg-[var(--color-cream)]">
    <div class="relative mx-auto max-w-2xl px-6 pb-10 pt-36 text-center">
      <img src={`${base}img/yubuu-wink-grass.png`} alt="Yubuu winkt" loading="lazy"
        class="pointer-events-none absolute left-full top-10 ml-6 hidden h-40 w-auto drop-shadow-[0_16px_26px_rgba(43,42,40,0.16)] xl:block" />
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Kontakt</p>
      <h1 class="mt-3 text-4xl sm:text-6xl">Sagen Sie hallo.</h1>
      <p class="mt-5 text-lg text-[var(--color-ink-soft)]">
        Egal ob Sie als pädagogische Fachkraft neugierig sind, EMORIA in Ihrer Kita
        auszuprobieren, oder als Elternteil auf dem Laufenden bleiben möchten, bis es startet —
        schreiben Sie uns eine Zeile. Cemil liest jede Nachricht.
      </p>
    </div>

    <div class="mx-auto max-w-xl px-6 pb-24">
      <form class="rounded-[2rem] border border-[var(--color-cream-edge)] bg-white/60 p-7 shadow-[var(--shadow-soft)] sm:p-9" data-contact>
        <div class="grid gap-5">
          <label class="block">
            <span class="text-sm font-medium text-[var(--color-ink)]">Ihr Name</span>
            <input type="text" name="name" required
              class="mt-1.5 w-full rounded-[var(--radius-card)] border border-[var(--color-cream-edge)] bg-[var(--color-cream)] px-4 py-3 outline-none focus:border-[var(--color-brand)]" />
          </label>

          <label class="block">
            <span class="text-sm font-medium text-[var(--color-ink)]">Kindergarten oder Einrichtung <span class="font-normal text-[var(--color-ink-faint)]">(optional)</span></span>
            <input type="text" name="organisation"
              class="mt-1.5 w-full rounded-[var(--radius-card)] border border-[var(--color-cream-edge)] bg-[var(--color-cream)] px-4 py-3 outline-none focus:border-[var(--color-brand)]" />
          </label>

          <label class="block">
            <span class="text-sm font-medium text-[var(--color-ink)]">E-Mail</span>
            <input type="email" name="email" required
              class="mt-1.5 w-full rounded-[var(--radius-card)] border border-[var(--color-cream-edge)] bg-[var(--color-cream)] px-4 py-3 outline-none focus:border-[var(--color-brand)]" />
          </label>

          <label class="block">
            <span class="text-sm font-medium text-[var(--color-ink)]">Ihre Nachricht</span>
            <textarea name="message" rows="4"
              class="mt-1.5 w-full rounded-[var(--radius-card)] border border-[var(--color-cream-edge)] bg-[var(--color-cream)] px-4 py-3 outline-none focus:border-[var(--color-brand)]"></textarea>
          </label>

          <button type="submit"
            class="rounded-[var(--radius-pill)] bg-[var(--color-brand)] px-7 py-3.5 font-[var(--font-body)] font-semibold text-white shadow-[var(--shadow-soft)] transition hover:bg-[var(--color-brand-deep)]">
            Nachricht senden
          </button>

          <p class="text-center text-sm text-[var(--color-ink-faint)]">
            Lieber per E-Mail? Schreiben Sie an <a href="mailto:hello@emoria.de" class="underline decoration-[var(--color-cream-edge)] underline-offset-2 hover:text-[var(--color-ink)]">hello@emoria.de</a>
          </p>
        </div>
      </form>
      <p class="mt-4 text-center text-xs text-[var(--color-ink-faint)]">
        Hinweis: Dieses Formular ist noch nicht an ein Backend angebunden, wir richten vor dem
        Start eine DSGVO-konforme Anbindung ein (und bestätigen die endgültige Adresse).
      </p>
    </div>
  </article>
</Base>
