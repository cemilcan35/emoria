---
import Base from '../../layouts/Base.astro';
// German-law Impressum (§5 DDG). Placeholder — fill with Cemil's real details before launch.
---

<Base lang="da" title="Juridisk information — EMORIA" current=""
  description="Juridisk information om EMORIA.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-2xl px-6 pb-24 pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Juridisk</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Juridisk information</h1>
      <p class="mt-4 rounded-[var(--radius-card)] bg-[var(--color-cream-deep)] px-4 py-3 text-sm text-[var(--color-ink-soft)]">Midlertidig pladsholder, udfyldes med de fuldstændige oplysninger inden lanceringen. Tysk ret kræver en fuldstændig juridisk information (Impressum) i henhold til §5 DDG.</p>

      <div class="mt-10 space-y-8 text-[var(--color-ink-soft)]">
        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Udbyder</h2>
          <p class="mt-2">Cemil Can Özkaya<br /> EMORIA<br /> [Gade og husnummer]<br /> [Postnummer] Berlin<br /> Tyskland</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Kontakt</h2>
          <p class="mt-2">E-mail: hello@emoria.de<br /> [Telefon, valgfrit]</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Ansvarlig for indholdet</h2>
          <p class="mt-2">Cemil Can Özkaya, adresse som ovenfor.</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Billedkreditering</h2>
          <p class="mt-2">Illustrationer og produktfotografi © EMORIA. Figurillustrationerne er skitser eller lavet med AI-støtte, indtil det endelige professionelle artwork foreligger.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
