---
import '@fontsource-variable/fraunces';
import Base from '../../layouts/Base.astro';
import AudienceHero from '../../components/audience/AudienceHero.astro';
import ClickBoxes from '../../components/audience/ClickBoxes.astro';
import IconRow from '../../components/audience/IconRow.astro';
import TwoCol from '../../components/audience/TwoCol.astro';
import ColoredBand from '../../components/audience/ColoredBand.astro';
import YubuuQuote from '../../components/audience/YubuuQuote.astro';
import Chips from '../../components/audience/Chips.astro';
import Accordion from '../../components/audience/Accordion.astro';
const base = import.meta.env.BASE_URL;
---
<Base lang="en" title="For Child Psychology — EMORIA" current="Child psychology"
  description="Yubuu's Feeling Wheel in child psychology practice: a playful, low-pressure way into a child's emotional world.">

  <AudienceHero
    eyebrow="✦ For Child Psychology"
    title="A gentle way into a child's emotional world: playful, structured and without pressure."
    body="Children who come into psychological care often find it hard to talk about what is on their mind. Direct questions can sometimes bring up exactly the defensiveness you were hoping to ease. Yubuu's Feeling Wheel offers a playful detour to the same goal: the child talks about a feeling that &quot;happened&quot; to come up on the wheel, not about themselves, and that is what makes it easier."
    image="img/hero-kinderpsychologie.jpg"
    imageAlt="Feeling faces on Yubuu's Feeling Wheel"
  />

  <ClickBoxes
    title="Why Yubuu's Feeling Wheel?"
    items={[
      { icon: '🎯', title: 'A detour that leads to the goal', text: 'Because the feelings are picked by spinning the wheel, seemingly at random, the conversation feels less like a direct confrontation to the child. There is a little distance from themselves, just enough to stay honest.' },
      { icon: '🔍', title: 'A structured way to observe', text: 'Which feelings does the child recognise with confidence, and which do they hesitate over? How do they read everyday situations, and which needs do they name? These observations come up on the side, during play, not in a test situation.' },
      { icon: '🕊️', title: 'No right, no wrong, no pressure', text: 'Yubuu judges nothing. For children who are often spoken to about their behaviour, this feels very different, and it builds trust before anything difficult is even discussed.' },
    ]}
  />

  <IconRow
    title="Ways to use Yubuu's Feeling Wheel"
    items={[
      { icon: '🧑‍⚕️', label: 'Individual therapy' },
      { icon: '📋', label: 'Initial diagnostic conversation' },
      { icon: '🕊️', label: 'Follow-up after stressful situations' },
      { icon: '📈', label: 'Tracking progress' },
      { icon: '👪', label: 'Preparing a parent conversation' },
      { icon: '🌱', label: 'Resource-oriented conversations' },
    ]}
  />

  <TwoCol
    title="What makes Yubuu's Feeling Wheel special?"
    body="The focus is not on the right answer but on discovering together. Yubuu doesn't judge answers but asks, wonders and listens, which lowers the barrier, especially for children who have learned to hide or control their feelings. Feelings don't stay abstract: spinning the Feeling Wheel, placing the magnetic heads, and playing with the flash cards, situation cards and needs circles make them visible, tangible and easier to talk about, even for children who find it hard to open up in words."
    image="img/rocket-puzzle-card.jpg"
    imageAlt="Situation card from Yubuu's Feeling Wheel"
  />

  <ColoredBand
    tone="petrol"
    title="A window into your young clients' inner world"
    body="For child psychologists, Yubuu's Feeling Wheel is more than a game. It is a structured way of observing. How does a child react to particular situation cards? Which needs do they name, and which are clearly missing? You can follow these observations across several sessions, and they give you a sound, traceable basis for diagnostics, therapy planning and reports."
  />

  <YubuuQuote
    quote="Hello! You don't have to tell me anything about yourself if you don't want to. But if you like, spin the wheel and we'll see together what comes up."
    image="yubuu-butterfly.png" imageAlt="Yubuu with a butterfly" />

  <Chips
    title="Who is the game for?"
    items={['Child psychologists', 'Child and adolescent psychotherapists', 'Staff in parenting and family counselling services', 'Social paediatric centres', 'Child and adolescent psychiatry practices']}
  />

  <Accordion
    items={[
      {
        title: 'How a round of the game works',
        body: 'A round follows five steps that build on one another. The child spins the Feeling Wheel and takes the magnetic head it lands on. This is a deliberate element of chance, and it brings in feelings the child might not have chosen. Next, the child draws a question card and says a few words about the feeling. Then comes a flash card: a short everyday situation where the child simply says whether the feeling fits or not. In the fourth step, the child places their magnetic head on a situation card that shows Yubuu with a blank face. Finally, the child picks from the needs circles what would help with this feeling. With one or two children, a full round takes about 10 to 20 minutes.',
      },
      {
        title: 'The science behind it',
        body: 'Yubuu\'s Feeling Wheel draws on several well-established approaches from developmental psychology and emotional learning. A meta-analysis by Durlak et al., covering more than 270,000 children, shows that structured social and emotional learning programmes clearly reduce behavioural difficulties and strengthen self-esteem. Neuroscientist Matthew Lieberman showed that simply naming a feeling has a calming effect on a child\'s brain, which is exactly what every round with the Feeling Wheel practises.',
        linkHref: `${base}en/wissenschaftlicher-hintergrund`,
        linkLabel: 'Read more about the science',
      },
      {
        title: 'Common questions from psychological practice',
        body: `
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Is the game suitable for children with anxiety or behavioural difficulties?</strong><br />Yes. The playful, indirect approach suits children who find direct questions hard.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Can I use the game for diagnostics?</strong><br />It doesn't replace standardised diagnostic tools, but it adds valuable observations that you can document.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Does the game work in one-to-one sessions?</strong><br />Yes, it was designed with that in mind. With one or two children, a round takes only 10 to 20 minutes.</p>
          <p><strong class="text-[var(--color-ink)]">What if a child doesn't want to answer?</strong><br />That is absolutely fine. Silence is a valid answer, not a failure to perform.</p>
        `,
      },
    ]}
  />

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <a href={`${base}en/contact`} class="inline-block rounded-[var(--radius-pill)] bg-[var(--color-terracotta)] px-8 py-3.5 font-[var(--font-body)] font-semibold text-white shadow-[var(--shadow-soft)] transition hover:bg-[var(--color-terracotta-deep)]">Enquire for your practice</a>
  </div>
</Base>
