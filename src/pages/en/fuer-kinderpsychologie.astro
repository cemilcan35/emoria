---
import '@fontsource-variable/fraunces';
import Base from '../../layouts/Base.astro';
import AudienceHero from '../../components/audience/AudienceHero.astro';
import ClickBoxes from '../../components/audience/ClickBoxes.astro';
import IconRow from '../../components/audience/IconRow.astro';
import TwoCol from '../../components/audience/TwoCol.astro';
import ColoredBand from '../../components/audience/ColoredBand.astro';
import YubuuQuote from '../../components/audience/YubuuQuote.astro';
import Chips from '../../components/audience/Chips.astro';
import Accordion from '../../components/audience/Accordion.astro';
const base = import.meta.env.BASE_URL;
---
<Base lang="en" title="For Child Psychology — EMORIA" current="Child psychology"
  description="Yubuu's Feeling Wheel in child psychology practice: a low-threshold, playful way into a child's emotional world.">

  <AudienceHero
    eyebrow="✦ For Child Psychology"
    title="A low-threshold way into a child's emotional world: playful, structured, without pressure."
    body="Children who come into psychological care often find it hard to talk about what is on their mind. Direct questions sometimes create exactly the defensiveness one actually wants to dissolve. Yubuu's Feeling Wheel offers a playful detour to the same goal: the child talks about a feeling that has &quot;happened&quot; to appear on the wheel, not about themselves, and that is exactly what makes it easier."
    image="img/hero-kinderpsychologie.jpg"
    imageAlt="Feeling faces on Yubuu's Feeling Wheel"
  />

  <ClickBoxes
    title="Why Yubuu's Feeling Wheel?"
    items={[
      { icon: '🎯', title: 'A detour that leads to the goal', text: 'Because the feelings are chosen by spinning the wheel, seemingly at random, the conversation feels less like a direct confrontation to the child. A certain distance from oneself arises, just enough to still stay honest.' },
      { icon: '🔍', title: 'A structured observation tool', text: 'Which feelings does the child recognise confidently, and which do they hesitate over? How do they interpret everyday situations, which needs do they name? These observations arise on the side, in play, not in a test situation.' },
      { icon: '🕊️', title: 'No right, no wrong, no pressure', text: 'Yubuu judges nothing. For children who are often addressed about their behaviour in everyday life, this is a noticeably different way of being met, one that builds trust before difficult things are even discussed.' },
    ]}
  />

  <IconRow
    title="How Yubuu's Feeling Wheel can be used"
    items={[
      { icon: '🧑‍⚕️', label: 'Individual therapy' },
      { icon: '📋', label: 'Diagnostic initial conversation' },
      { icon: '🕊️', label: 'Follow-up conversation after stressful situations' },
      { icon: '📈', label: 'Documenting progress' },
      { icon: '👪', label: 'Preparing a parent conversation' },
      { icon: '🌱', label: 'Resource-oriented conversations' },
    ]}
  />

  <TwoCol
    title="What makes Yubuu's Feeling Wheel special?"
    body="The focus is not on the right answer, but on discovering together. Yubuu does not judge answers, but asks, wonders and listens, which lowers the barrier, especially for children who have learned to hide or control their feelings. Feelings do not stay abstract: spinning the Feeling Wheel, placing the magnetic heads, and working with the flash cards, situation cards and needs circles make them visible, tangible and possible to talk about, even for children who find it hard to open up verbally."
    image="img/rocket-puzzle-card.jpg"
    imageAlt="Situation card from Yubuu's Feeling Wheel"
  />

  <ColoredBand
    tone="petrol"
    title="A window into the inner world of your young patients"
    body="For child psychologists, Yubuu's Feeling Wheel is more than a game: it is a structured observation tool. How does a child react to certain situation cards? Which needs do they name, and which are visibly missing? These observations can be followed across several sessions and provide a sound, traceable basis for diagnostics, therapy planning and reports."
  />

  <YubuuQuote
    quote="Hello! You don't have to tell me anything about yourself if you don't want to. But if you like, spin the wheel, and we'll see together what comes out of it."
    image="yubuu-butterfly.png" imageAlt="Yubuu with a butterfly" />

  <Chips
    title="Who is the game suitable for?"
    items={['Child psychologists', 'Child and adolescent psychotherapists', 'Professionals in parenting and family counselling services', 'Social paediatric centres', 'Child and adolescent psychiatric practices']}
  />

  <Accordion
    items={[
      {
        title: 'How a round of the game works',
        body: 'A round of the game follows five steps that build on one another. The child spins the Feeling Wheel and takes their magnetic head, a deliberate element of chance that also brings feelings into the game that the child would not have chosen spontaneously. Next, the child draws a question card and talks briefly about the feeling. Then comes a flash card: a short everyday situation where the child only says whether the feeling fits or not. In the fourth step, the child places their magnetic head on a situation card that shows Yubuu with no facial expression. Finally, the child chooses from the needs circles what would help with this feeling. With one or two children, a complete round takes about 10 to 20 minutes.',
      },
      {
        title: 'Scientific background',
        body: 'Yubuu\'s Feeling Wheel is built on several recognised approaches from developmental psychology and emotional education. The meta-analysis by Durlak et al., covering over 270,000 children, shows that structured social and emotional learning programmes significantly reduce behavioural problems and strengthen self-esteem. Neuroscientist Matthew Lieberman has shown that simply naming a feeling has a calming effect on a child\'s brain, and that is exactly what every round with the Feeling Wheel practises.',
        linkHref: `${base}en/wissenschaftlicher-hintergrund`,
        linkLabel: 'More on the scientific background',
      },
      {
        title: 'Frequently asked questions from psychological practice',
        body: `
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Is the game suitable for children with anxiety or behavioural difficulties?</strong><br />Yes, the playful, indirect approach is especially suited to children who find direct questions hard.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Can I use the game for diagnostics?</strong><br />It does not replace standardised diagnostic procedures, but it provides valuable, documentable observations as a complement.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Does the game work in one-to-one settings?</strong><br />Yes, it was designed with that in mind. With one or two children, a round takes only 10 to 20 minutes.</p>
          <p><strong class="text-[var(--color-ink)]">What if a child does not want to answer?</strong><br />That is explicitly fine. Silence is a valid answer, not a failure to perform.</p>
        `,
      },
    ]}
  />

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <a href={`${base}en/contact`} class="inline-block rounded-[var(--radius-pill)] bg-[var(--color-terracotta)] px-8 py-3.5 font-[var(--font-body)] font-semibold text-white shadow-[var(--shadow-soft)] transition hover:bg-[var(--color-terracotta-deep)]">Enquire for your practice</a>
  </div>
</Base>
