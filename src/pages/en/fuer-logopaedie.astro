---
import '@fontsource-variable/fraunces';
import Base from '../../layouts/Base.astro';
import AudienceHero from '../../components/audience/AudienceHero.astro';
import ClickBoxes from '../../components/audience/ClickBoxes.astro';
import IconRow from '../../components/audience/IconRow.astro';
import TwoCol from '../../components/audience/TwoCol.astro';
import ColoredBand from '../../components/audience/ColoredBand.astro';
import YubuuQuote from '../../components/audience/YubuuQuote.astro';
import Chips from '../../components/audience/Chips.astro';
import Accordion from '../../components/audience/Accordion.astro';
const base = import.meta.env.BASE_URL;
---
<Base lang="en" title="For Speech Therapy — EMORIA" current="Speech therapy"
  description="Yubuu's Feeling Wheel in speech and language therapy: emotional vocabulary, spontaneous speech and natural reasons to talk.">

  <AudienceHero
    eyebrow="✦ For Speech Therapy"
    title="Where language and feelings meet: playful, structured and ready to use straight away."
    body="Many children in speech therapy find it hard not only to produce sounds and sentences but also to put their feelings into words. Emotional vocabulary and language skills are closely linked: without a word for a feeling, it is hard to express it, however clear the articulation. Yubuu's Feeling Wheel brings both together in one short exercise."
    image="img/hero-logopaedie.jpg"
    imageAlt="Question cards from Yubuu's Feeling Wheel, fanned out"
  />

  <ClickBoxes
    title="Why Yubuu's Feeling Wheel?"
    items={[
      { icon: '🗣️', title: 'Feeling words as part of real language', text: 'The game deliberately practises feeling words, from simple basic feelings to finer shades such as disappointment or pride. Unlike isolated word lists, these words come up in a real context that matters to the child. They are not learned by heart but experienced.' },
      { icon: '🧑‍⚕️', title: 'Made for one-to-one sessions', text: 'With one or two children, a round takes about 10 to 20 minutes and slots into a regular therapy session without any preparation, either as an exercise in its own right or as a warm-up before the actual language work.' },
      { icon: '🧩', title: 'Natural reasons to talk', text: 'Instead of set practice sentences, children produce real, spontaneous speech: they describe a situation, explain their choice and tell stories from their own lives. Free speech like this is often harder to practise than guided sentences, and the game draws it out naturally.' },
    ]}
  />

  <IconRow
    title="Ways to use Yubuu's Feeling Wheel"
    items={[
      { icon: '🗣️', label: 'Language support session' },
      { icon: '🧑‍⚕️', label: 'Individual therapy' },
      { icon: '🔤', label: 'Vocabulary work' },
      { icon: '💬', label: 'Encouraging spontaneous speech' },
      { icon: '📈', label: 'Tracking progress' },
      { icon: '👪', label: 'Preparing a parent conversation' },
    ]}
  />

  <TwoCol
    title="What makes Yubuu's Feeling Wheel special?"
    body="The focus is not on the right answer but on discovering together. Yubuu judges nothing, but asks, wonders and listens, which takes away the pressure to perform that many children already know from speech training. Feelings don't stay abstract: spinning the Feeling Wheel, placing the magnetic heads, and playing with the flash cards, situation cards and needs circles give children concrete reasons to talk, and it feels natural rather than rehearsed."
    image="img/rocket-puzzle-card.jpg"
    imageAlt="Situation card from Yubuu's Feeling Wheel"
  />

  <ColoredBand
    tone="petrol"
    title="A window into your young clients' language"
    body="For speech and language therapists, Yubuu's Feeling Wheel is more than a game. It shows you at once which emotional vocabulary a child already has and where the gaps are. Can the child name a feeling alone, or do they need help? Do they use simple words or more nuanced ones? You can take these observations straight into therapy planning and progress notes."
  />

  <YubuuQuote
    quote="Hello! I don't know all the words for feelings yet, so I'm asking you. What do you call what you're feeling right now?"
    image="yubuu-crystal.png" imageAlt="Yubuu with a glowing crystal" />

  <Chips
    title="Who is the game for?"
    items={['Speech and language therapists', 'Language therapists', 'Staff in early intervention services', 'Speech and language educators', 'Speech, language and voice therapy practices']}
  />

  <Accordion
    items={[
      {
        title: 'How a round of the game works',
        body: 'A round follows five steps that build on one another. The child spins the Feeling Wheel and takes the magnetic head it lands on. This is a deliberate element of chance, and it brings in feelings the child might not have chosen. Next, the child draws a question card and says a few words about the feeling. Then comes a flash card: a short everyday situation where the child simply says whether the feeling fits or not. In the fourth step, the child places their magnetic head on a situation card that shows Yubuu with a blank face. Finally, the child picks from the needs circles what would help with this feeling. With one or two children, a full round takes about 10 to 20 minutes.',
      },
      {
        title: 'The science behind it',
        body: 'Yubuu\'s Feeling Wheel draws on several well-established approaches from developmental psychology and emotional learning. A meta-analysis by Durlak et al., covering more than 270,000 children, shows that structured social and emotional learning programmes clearly reduce behavioural difficulties and strengthen self-esteem. Research on embodied learning also shows that children learn more deeply when they do things with their bodies instead of just listening, which is why the game material is deliberately hands-on.',
        linkHref: `${base}en/wissenschaftlicher-hintergrund`,
        linkLabel: 'Read more about the science',
      },
      {
        title: 'Common questions from speech therapy practice',
        body: `
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Is the game suitable for children with developmental language disorders?</strong><br />Yes, and for these children in particular, a playful approach without pressure is especially valuable. The hands-on elements give them a way to express themselves even when the right words are still missing.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Does the game replace targeted vocabulary training?</strong><br />No, it complements it. Instead of isolated exercises, feeling words come up in a real, meaningful context.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Does the game work in one-to-one sessions?</strong><br />Yes, it was designed with that in mind. With one or two children, a round takes only 10 to 20 minutes.</p>
          <p><strong class="text-[var(--color-ink)]">Do I need training?</strong><br />No, you can start using the game right away, without extra training.</p>
        `,
      },
    ]}
  />

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <a href={`${base}en/contact`} class="inline-block rounded-[var(--radius-pill)] bg-[var(--color-terracotta)] px-8 py-3.5 font-[var(--font-body)] font-semibold text-white shadow-[var(--shadow-soft)] transition hover:bg-[var(--color-terracotta-deep)]">Enquire for your practice</a>
  </div>
</Base>
