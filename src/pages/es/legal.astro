---
import Base from '../../layouts/Base.astro';
// German-law Impressum (§5 DDG). Placeholder — fill with Cemil's real details before launch.
---

<Base lang="es" title="Aviso legal — EMORIA" current=""
  description="Aviso legal de EMORIA.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-2xl px-6 pb-24 pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Información legal</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Aviso legal</h1>
      <p class="mt-4 rounded-[var(--radius-card)] bg-[var(--color-cream-deep)] px-4 py-3 text-sm text-[var(--color-ink-soft)]">Marcador provisional, se completará con los datos completos antes de la puesta en marcha. La legislación alemana exige un aviso legal completo conforme al §5 DDG.</p>

      <div class="mt-10 space-y-8 text-[var(--color-ink-soft)]">
        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Proveedor</h2>
          <p class="mt-2">Cemil Can Özkaya<br /> EMORIA<br /> [Calle y número]<br /> [Código postal] Berlín<br /> Alemania</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Contacto</h2>
          <p class="mt-2">Correo electrónico: hello@emoria.de<br /> [Teléfono, opcional]</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Responsable del contenido</h2>
          <p class="mt-2">Cemil Can Özkaya, dirección como arriba.</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Créditos de imágenes</h2>
          <p class="mt-2">Ilustraciones y fotografía de producto © EMORIA. Las ilustraciones de personajes son bocetos o creadas con ayuda de IA, hasta que esté disponible el arte profesional definitivo.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
