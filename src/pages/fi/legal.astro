---
import Base from '../../layouts/Base.astro';
// German-law Impressum (§5 DDG). Placeholder — fill with Cemil's real details before launch.
---

<Base lang="fi" title="Oikeudelliset tiedot — EMORIA" current=""
  description="EMORIAn oikeudelliset tiedot.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-2xl px-6 pb-24 pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Oikeudellista</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Oikeudelliset tiedot</h1>
      <p class="mt-4 rounded-[var(--radius-card)] bg-[var(--color-cream-deep)] px-4 py-3 text-sm text-[var(--color-ink-soft)]">Luonnos, väliaikainen paikkamerkki, täydennetään täydellisillä tiedoilla ennen julkaisua. Saksan laki vaatii täydelliset oikeudelliset tiedot (Impressum) §5 DDG:n mukaisesti.</p>

      <div class="mt-10 space-y-8 text-[var(--color-ink-soft)]">
        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Palveluntarjoaja</h2>
          <p class="mt-2">Cemil Can Özkaya<br /> EMORIA<br /> [Katu ja talonnumero]<br /> [Postinumero] Berliini<br /> Saksa</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Yhteystiedot</h2>
          <p class="mt-2">Sähköposti: hello@emoria.de<br /> [Puhelin, valinnainen]</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Sisällöstä vastaava</h2>
          <p class="mt-2">Cemil Can Özkaya, osoite kuten yllä.</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Kuvien tekijätiedot</h2>
          <p class="mt-2">Kuvitukset ja tuotekuvaus © EMORIA. Hahmokuvitukset ovat luonnoksia tai tekoälyn avulla tehtyjä, kunnes lopullinen ammattimainen kuvitus on valmis.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
