---
import Base from '../../layouts/Base.astro';
// The German-law Impressum (§5 DDG). Placeholder — fill with Cemil's real
// details before launch. German law requires the German version to be
// authoritative; this French page is a courtesy translation for visitors.
---

<Base lang="fr" title="Mentions légales — EMORIA" current=""
  description="Mentions légales d'EMORIA.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-2xl px-6 pb-24 pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Mentions légales</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Mentions légales</h1>
      <p class="mt-4 rounded-[var(--radius-card)] bg-[var(--color-cream-deep)] px-4 py-3 text-sm text-[var(--color-ink-soft)]">
        Version provisoire — à compléter avec les informations réelles avant la mise en ligne.
        Le droit allemand impose des mentions légales complètes (Impressum, §5 DDG) ; la
        version allemande fait foi.
      </p>

      <div class="mt-10 space-y-8 text-[var(--color-ink-soft)]">
        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Éditeur</h2>
          <p class="mt-2">
            Cemil Can Özkaya<br />
            EMORIA<br />
            [Adresse]<br />
            [Code postal] Berlin<br />
            Allemagne
          </p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Contact</h2>
          <p class="mt-2">
            E-mail : hello@emoria.de<br />
            [Téléphone, facultatif]
          </p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Responsable du contenu</h2>
          <p class="mt-2">Cemil Can Özkaya, adresse ci-dessus.</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Crédits photo</h2>
          <p class="mt-2">Illustrations et photographies produit © EMORIA. Les illustrations du personnage sont des esquisses / assistées par IA en attendant les illustrations professionnelles finales.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
