---
import Base from '../layouts/Base.astro';
// German-law Impressum (§5 DDG). Placeholder — fill with Cemil's real details before launch.
---

<Base title="Impressum — EMORIA" current=""
  description="Impressum von EMORIA.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-2xl px-6 pb-24 pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Rechtliches</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Impressum</h1>
      <p class="mt-4 rounded-[var(--radius-card)] bg-[var(--color-cream-deep)] px-4 py-3 text-sm text-[var(--color-ink-soft)]">
        Entwurf-Platzhalter, wird vor dem Livegang mit den vollständigen Angaben ergänzt. Das
        deutsche Recht schreibt ein vollständiges Impressum gemäß §5 DDG vor.
      </p>

      <div class="mt-10 space-y-8 text-[var(--color-ink-soft)]">
        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Anbieter</h2>
          <p class="mt-2">
            Cemil Can Özkaya<br />
            EMORIA<br />
            [Straße und Hausnummer]<br />
            [Postleitzahl] Berlin<br />
            Deutschland
          </p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Kontakt</h2>
          <p class="mt-2">
            E-Mail: hello@emoria.de<br />
            [Telefon, optional]
          </p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Verantwortlich für den Inhalt</h2>
          <p class="mt-2">Cemil Can Özkaya, Anschrift wie oben.</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Bildnachweise</h2>
          <p class="mt-2">Illustrationen und Produktfotografie © EMORIA. Charakterillustrationen sind Entwürfe / KI-unterstützt, bis das finale professionelle Artwork vorliegt.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
