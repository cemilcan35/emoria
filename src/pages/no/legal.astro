---
import Base from '../../layouts/Base.astro';
// German-law Impressum (§5 DDG). Placeholder — fill with Cemil's real details before launch.
---

<Base lang="no" title="Juridisk informasjon — EMORIA" current=""
  description="Juridisk informasjon om EMORIA.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-2xl px-6 pb-24 pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Juridisk</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Juridisk informasjon</h1>
      <p class="mt-4 rounded-[var(--radius-card)] bg-[var(--color-cream-deep)] px-4 py-3 text-sm text-[var(--color-ink-soft)]">Midlertidig plassholder, fylles ut med fullstendige opplysninger før lansering. Tysk lov krever en fullstendig juridisk informasjon (Impressum) etter §5 DDG.</p>

      <div class="mt-10 space-y-8 text-[var(--color-ink-soft)]">
        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Leverandør</h2>
          <p class="mt-2">Cemil Can Özkaya<br /> EMORIA<br /> [Gate og husnummer]<br /> [Postnummer] Berlin<br /> Tyskland</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Kontakt</h2>
          <p class="mt-2">E-post: hello@emoria.de<br /> [Telefon, valgfritt]</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Ansvarlig for innholdet</h2>
          <p class="mt-2">Cemil Can Özkaya, adresse som ovenfor.</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Bildekreditering</h2>
          <p class="mt-2">Illustrasjoner og produktfotografi © EMORIA. Figurillustrasjonene er skisser eller laget med KI-støtte inntil det endelige profesjonelle artworket foreligger.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
