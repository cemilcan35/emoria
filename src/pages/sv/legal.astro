---
import Base from '../../layouts/Base.astro';
// German-law Impressum (§5 DDG). Placeholder — fill with Cemil's real details before launch.
---

<Base lang="sv" title="Juridisk information — EMORIA" current=""
  description="Juridisk information om EMORIA.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-2xl px-6 pb-24 pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Juridiskt</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Juridisk information</h1>
      <p class="mt-4 rounded-[var(--radius-card)] bg-[var(--color-cream-deep)] px-4 py-3 text-sm text-[var(--color-ink-soft)]">Preliminär platshållare, kompletteras med fullständiga uppgifter före lansering. Tysk lag kräver en fullständig juridisk information (Impressum) enligt §5 DDG.</p>

      <div class="mt-10 space-y-8 text-[var(--color-ink-soft)]">
        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Leverantör</h2>
          <p class="mt-2">Cemil Can Özkaya<br /> EMORIA<br /> [Gata och husnummer]<br /> [Postnummer] Berlin<br /> Tyskland</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Kontakt</h2>
          <p class="mt-2">E-post: hello@emoria.de<br /> [Telefon, valfritt]</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Ansvarig för innehållet</h2>
          <p class="mt-2">Cemil Can Özkaya, adress som ovan.</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Bildkrediter</h2>
          <p class="mt-2">Illustrationer och produktfotografi © EMORIA. Karaktärsillustrationerna är skisser eller framtagna med AI-stöd tills den slutliga professionella grafiken finns.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
