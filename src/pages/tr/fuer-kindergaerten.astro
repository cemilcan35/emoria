---
import '@fontsource-variable/fraunces';
import Base from '../../layouts/Base.astro';
import AudienceHero from '../../components/audience/AudienceHero.astro';
import ClickBoxes from '../../components/audience/ClickBoxes.astro';
import IconRow from '../../components/audience/IconRow.astro';
import TwoCol from '../../components/audience/TwoCol.astro';
import ColoredBand from '../../components/audience/ColoredBand.astro';
import YubuuQuote from '../../components/audience/YubuuQuote.astro';
import Chips from '../../components/audience/Chips.astro';
import Accordion from '../../components/audience/Accordion.astro';
const base = import.meta.env.BASE_URL;
---
<Base lang="tr" title="Anaokulları İçin — EMORIA" current="Anaokulu"
  description="Yubuu'nun Duygu Çarkı anaokulunun gündelik akışında: kolay uygulanır, bilimsel temele dayanır, eğitimciler için geliştirildi.">

  <AudienceHero
    eyebrow="✦ Anaokulları İçin"
    title="Duyguları birlikte keşfedin: oyunla, günlük hayatın içinde ve neredeyse hiç hazırlık gerektirmeden."
    body="Çocuklar her gün sayısız duygu yaşar: oyun oynarken sevinç, kavgadan sonra öfke, bir başarının ardından gurur, anne babadan ayrılırken hüzün. Ama birçok çocuk içinde olup biteni henüz kelimelere dökemez. Yubuu'nun Duygu Çarkı, eğitimcilerin çocuklara bu anlarda oyun yoluyla eşlik etmesine yardımcı olur: güvenli bir ortamda, başarı baskısı olmadan, doğru ya da yanlış cevap diye bir şey olmadan."
    image="img/wheel-hero.jpg"
    imageAlt="Anaokulunda Yubuu'nun Duygu Çarkı"
  />

  <ClickBoxes
    title="Neden Yubuu'nun Duygu Çarkı?"
    items={[
      { icon: '🧩', title: 'Anaokulu gününe kolayca sığar', text: 'Oyun, eğitimcilerin günlük çalışmasına göre tasarlandı. Fazla hazırlık gerektirmez; küçük gruplarla ya da bire bir kullanılabilir, yaşa, grup büyüklüğüne ve duruma göre esnetilebilir.' },
      { icon: '💛', title: 'Duygusal becerileri oyunla geliştirin', text: 'Çocuklar duyguları fark etmeyi, adlandırmayı ve anlamayı öğrenir. Aynı zamanda farklı insanların aynı durumu çok farklı yaşayabildiğini keşfeder. Böylece empati, kendini başkasının yerine koyabilme ve dil gelişimi kendiliğinden desteklenir.' },
      { icon: '🤝', title: 'Çocuğa aileyle birlikte eşlik edin', text: 'Oyun, tur bittikten sonra da sürecek değerli sohbet fırsatları yaratır. Oyunda gözlemledikleriniz veli görüşmelerinde ele alınabilir ve çocuğun duygusal gelişimine birlikte eşlik etmenize yardımcı olur.' },
    ]}
  />

  <IconRow
    title="Yubuu'nun Duygu Çarkı nerelerde kullanılabilir?"
    items={[
      { icon: '🌅', label: 'Sabah çemberi' },
      { icon: '👥', label: 'Küçük gruplar' },
      { icon: '🧑‍🤝‍🧑', label: 'Bire bir destek' },
      { icon: '🎒', label: 'Okul öncesi grupları' },
      { icon: '💬', label: 'Çatışma sonrası sohbetler' },
      { icon: '🌱', label: 'Duygusal eğitim projeleri' },
      { icon: '🕊️', label: 'Zor anların ardından sakin bir sohbet başlangıcı' },
    ]}
  />

  <TwoCol
    title="Yubuu'nun Duygu Çarkı'nı özel kılan nedir?"
    body="Merkezde doğru sonuç değil, birlikte keşfetmek var. Yubuu hiçbir cevabı değerlendirmez. Bunun yerine meraklı sorular sorar, dikkatle dinler ve çocukları kendi duygu dünyalarını tanımaya davet eder. Böylece çocukların ciddiye alındığını hissettiği ve güven duyabildiği bir ortam doğar. Duygular da soyut kalmaz: Duygu Çarkı'nı çevirerek, mıknatıs kafaları yerleştirerek, blitz kartları, durum kartları ve ihtiyaç çemberleriyle çalışarak çocuklar duyguları görebilir, dokunabilir ve anlayabilir."
    image="img/flash-card.jpg"
    imageAlt="Yubuu'nun Duygu Çarkı'ndan blitz kartı"
  />

  <ColoredBand
    tone="petrol"
    title="Çocukların duygu dünyasına açılan bir pencere"
    body="Eğitimciler için Yubuu'nun Duygu Çarkı bir oyundan fazlası, aynı zamanda bir gözlem aracıdır. Oyun sırasında bir çocuğu şu an hangi duyguların meşgul ettiğini, durumları nasıl yorumladığını ve nerede konuşmaya ihtiyaç duyabileceğini görebilirsiniz. Bu gözlemler, her çocuğa daha bireysel biçimde eşlik etmenize ve kendi pedagojik çalışmanızı daha isabetli yönlendirmenize yardımcı olur."
  />

  <YubuuQuote quote="Merhaba! Burada olduğun için çok mutluyum. Birlikte duyguları keşfedeceğiz, doğru yanlış diye bir şey olmadan. Dinlerim, sorular sorarım ve her gün yeni bir şey öğrenirim. Keşif yolculuğumuza katılır mısın?" image="yubuu-vine.png" imageAlt="Yubuu bir bitki keşfediyor" />

  <Chips
    title="Oyun kimler için uygun?"
    items={['Anaokulu eğitimcileri', 'Kaynaştırma eğitimcileri', 'Özel eğitim uzmanları', 'Dil gelişimi destek uzmanları', 'Anaokulu müdürleri', 'Okul öncesi grupları', 'Aile merkezleri']}
  />

  <Accordion
    items={[
      {
        title: 'Bir oyun turu nasıl işler?',
        body: 'Bir oyun turu, birbirini tamamlayan beş adımdan oluşur. Önce çocuk Duygu Çarkı\'nı çevirir ve çarkın durduğu yerdeki mıknatıs kafayı alır. Bu, bilinçli bir rastlantı unsurudur; çocuğun kendiliğinden seçmeyeceği duyguları da oyuna getirir. Sonra çocuk bir soru kartı çeker ve duygu hakkında kısaca konuşur. Ardından bir blitz kartı gelir: Çocuğun yalnızca duygunun uyup uymadığını söylediği kısa bir günlük hayat durumu. Dördüncü adımda çocuk, mıknatıs kafasını Yubuu\'yu ifadesiz bir yüzle gösteren bir durum kartının üzerine koyar. Son olarak çocuk, ihtiyaç çemberlerinden bu duyguda kendisine neyin iyi geleceğini seçer. Tam bir tur, gruba ve sohbetin derinliğine göre değişmekle birlikte yaklaşık 25 ila 40 dakika sürer, bazen daha uzun da olabilir. Sonunda Yubuu kısa bir değerlendirme sohbeti yapar: Şimdi nasıl hissediyorsun? Oyunu sevdin mi?',
      },
      {
        title: 'Bilimsel arka plan',
        body: 'Yubuu\'nun Duygu Çarkı, gelişim psikolojisi ve duygusal eğitimdeki köklü yaklaşımlara dayanır. Durlak ve arkadaşlarının 270.000\'den fazla çocuğu kapsayan meta-analizi, yapılandırılmış sosyal ve duygusal öğrenme programlarının davranış sorunlarını belirgin biçimde azalttığını ve benlik saygısını güçlendirdiğini gösteriyor. Sinirbilimci Matthew Lieberman, bir duyguyu yalnızca adlandırmanın çocuğun beynini yatıştırdığını ortaya koydu; Duygu Çarkı\'ndaki her tur tam olarak bunu pekiştirir. Bedensel öğrenme (embodied learning) araştırmaları da çocukların yalnızca dinlemek yerine bedenleriyle hareket ettiklerinde daha derin öğrendiğini gösteriyor. Oyun materyalinin bilinçli olarak elle tutulur olmasının nedeni bu.',
        linkHref: `${base}tr/wissenschaftlicher-hintergrund`,
        linkLabel: 'Bilimsel arka plan hakkında daha fazlası',
      },
      {
        title: 'Anaokullarından sık sorulan sorular',
        body: `
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Bir oyun turu ne kadar sürer?</strong><br />Grup büyüklüğüne ve sohbetin derinliğine bağlı olarak yaklaşık 25 ila 40 dakika. Yalnızca bazı bileşenlerle oynanan daha kısa seçenekler de mümkün.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Oyunu kullanmak için eğitim almam gerekir mi?</strong><br />Hayır. Oyun, ek bir eğitim gerektirmeden hemen kullanılabilecek şekilde tasarlandı. Bir tanıtım faydalıdır ama şart değildir.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Oyun hangi yaş için uygun?</strong><br />Dört ile altı yaş arası çocuklar için. Bu aralıkta daha küçükler ve daha büyükler için ayrı birer akış var.</p>
          <p><strong class="text-[var(--color-ink)]">Oyunun yalnızca bazı parçalarını kullanabilir miyim?</strong><br />Evet. Duygu Çarkı ve blitz kartları tek başına da işe yarar, örneğin zamanın kısıtlı olduğu durumlarda.</p>
        `,
      },
    ]}
  />

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <a href={`${base}tr/contact`} class="inline-block rounded-[var(--radius-pill)] bg-[var(--color-terracotta)] px-8 py-3.5 font-[var(--font-body)] font-semibold text-white shadow-[var(--shadow-soft)] transition hover:bg-[var(--color-terracotta-deep)]">Anaokulunuz için bilgi talep edin</a>
  </div>
</Base>
