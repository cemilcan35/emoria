---
import '@fontsource-variable/fraunces';
import Base from '../../layouts/Base.astro';
import AudienceHero from '../../components/audience/AudienceHero.astro';
import ClickBoxes from '../../components/audience/ClickBoxes.astro';
import IconRow from '../../components/audience/IconRow.astro';
import TwoCol from '../../components/audience/TwoCol.astro';
import ColoredBand from '../../components/audience/ColoredBand.astro';
import YubuuQuote from '../../components/audience/YubuuQuote.astro';
import Chips from '../../components/audience/Chips.astro';
import Accordion from '../../components/audience/Accordion.astro';
const base = import.meta.env.BASE_URL;
---
<Base lang="tr" title="Okullar İçin — EMORIA" current="Okul"
  description="Yubuu'nun Duygu Çarkı ilkokulun gündelik akışında: sınıf toplantıları, okul sosyal hizmeti ve destek saatleri için, bilimsel temele dayanır.">

  <AudienceHero
    eyebrow="✦ Okullar İçin"
    title="Sosyal ve duygusal öğrenmenin yeri her sınıftır: arada kalan bir konu olarak değil, bilinçli bir şekilde."
    body="İlkokulda çocuklar yalnızca matematik ve dil derslerini öğrenmez. Arkadaşlık kurmayı, çatışmalarla başa çıkmayı, kendilerinin ve başkalarının sorumluluğunu almayı da öğrenir. Ama bir duyguyu yaşamak ile onu adlandırabilmek ayrı şeylerdir. Yubuu'nun Duygu Çarkı, öğretmenlerin ve okul sosyal hizmet uzmanlarının çocuklara korunaklı bir alan sunmasına yardımcı olur. Çocuklar bu alanda duygu dünyalarını oyunla keşfedebilir, anlayabilir ve onlardan söz edebilir."
    image="img/wheel-wide.jpg"
    imageAlt="Sınıf toplantısında Yubuu'nun Duygu Çarkı"
  />

  <ClickBoxes
    title="Neden Yubuu'nun Duygu Çarkı?"
    items={[
      { icon: '🧩', title: 'Okul gününde esnek biçimde kullanılır', text: 'İster sınıf toplantısı, ister küçük grup, okul sosyal hizmeti ya da destek saati olsun, bir oyun turu yaklaşık 25 ila 40 dakika sürer ve ek bir eğitim gerekmeden hemen kullanılabilir.' },
      { icon: '🕊️', title: 'Çatışmaları büyütmeden anlamak', text: 'Duygularını ve ihtiyaçlarını daha iyi anlayan çocuklar, çatışmalarla başa çıkmanın yapıcı yollarını daha kolay bulur.' },
      { icon: '💬', title: 'Veli görüşmeleri için ipuçları', text: 'Oyunda yaptığınız gözlemler, bir çocuğu hangi konuların meşgul ettiğini gösterir ve veli görüşmeleri ile bireysel destek için değerli bir zemin oluşturur.' },
    ]}
  />

  <IconRow
    title="Yubuu'nun Duygu Çarkı nerelerde kullanılıyor?"
    items={[
      { icon: '🗣️', label: 'Sınıf toplantısı' },
      { icon: '👥', label: 'Küçük gruplar' },
      { icon: '🤝', label: 'Okul sosyal hizmeti' },
      { icon: '📘', label: 'Destek saatleri' },
      { icon: '🔁', label: 'Boş ders saatleri' },
      { icon: '💛', label: 'Sınıftaki çatışmaların ardından' },
      { icon: '🌱', label: 'Önleme projeleri' },
      { icon: '🌍', label: 'Kaynaştırma eğitimi' },
    ]}
  />

  <TwoCol
    title="Yubuu'nun Duygu Çarkı'nı özel kılan nedir?"
    body="İlkokul çocukları da aktif olarak keşfettiklerinde, denediklerinde ve birbirleriyle konuştuklarında daha kalıcı öğrenir. Yubuu'nun Duygu Çarkı, oyunla öğrenmeyi sosyal ve duygusal becerilerin gelişimiyle buluşturur. Yubuu bu süreçte merakla ve takdirle eşlik eder. Cevap vermek yerine çocukları kendi düşüncelerini geliştirmeye ve farklı bakış açılarını tanımaya davet eder. Yedi ile on yaş arasındaki çocuklar birbirini tamamlayan beş adımdan geçer: Bir duyguyu keşfeder, onun hakkında konuşur, günlük hayattan durumlarla ilişkilendirir ve sonunda ardındaki ihtiyacı fark eder."
    image="img/rocket-puzzle-card.jpg"
    imageAlt="Yubuu'nun Duygu Çarkı'ndan durum kartı"
  />

  <ColoredBand
    tone="petrol"
    title="Güçlü bir sınıf iklimi sohbetlerle başlar"
    body="İyi bir sınıf iklimi kendiliğinden oluşmaz. Çocukların dinlemeyi, farklı bakış açılarını anlamayı ve çatışmaları saygıyla çözmeyi öğrenmesi gerekir. Yubuu'nun Duygu Çarkı, tam da bu becerilerin oyunla alıştırıldığı güvenli bir çerçeve sunar. Böylece yalnızca tek tek çocuklar değil, sınıf topluluğu da güçlenir. Öğretmenler ve okul sosyal hizmet uzmanları için oyun, aynı zamanda çocukların duygu dünyasına dair değerli içgörüler ve veli görüşmeleri ile bireysel destek için sağlam bir temel sağlar."
  />

  <YubuuQuote quote="Her sınıfta herkes farklı hisseder. Gelin bunun hakkında nasıl konuşabileceğimizi birlikte bulalım." image="yubuu-crystal.png" imageAlt="Yubuu parlayan bir kristalle" />

  <Chips
    title="Oyun kimler için uygun?"
    items={['İlkokul öğretmenleri', 'Okul sosyal hizmet uzmanları', 'Özel eğitim öğretmenleri', 'Rehber öğretmenler', 'Okul sonrası bakım eğitimcileri', 'Sınıf öğretmenleri', 'Kaynaştırma eğitimi uzmanları', 'Okul psikologları', 'ilkokul çocuklarıyla çalışan herkes']}
  />

  <Accordion
    items={[
      {
        title: 'Bir oyun turu nasıl işler?',
        body: 'İlkokul çocukları beş adımdan geçer: Bir duyguyu keşfeder, onun hakkında konuşur, günlük hayattan bir durumla ilişkilendirir ve sonunda ardındaki ihtiyacı fark eder. Bir tur yaklaşık 25 ila 40 dakika sürer; sohbetin derinliğine ve grubun büyüklüğüne göre biraz daha uzun ya da kısa olabilir. Sonunda Yubuu kısa bir değerlendirme sohbeti yapar: Oyun sizin için nasıldı? Kim bunun hakkında konuşmak ister?',
      },
      {
        title: 'Bilimsel arka plan',
        body: 'Yubuu\'nun Duygu Çarkı, eğitim bilimleri ve psikolojideki köklü yaklaşımlara dayanır. Durlak ve arkadaşlarının 270.000\'den fazla çocuğu kapsayan meta-analizi, yapılandırılmış sosyal ve duygusal öğrenmenin akademik başarıyı ortalama yüzde on bir artırdığını ve çatışmaları azalttığını gösteriyor. Oyunun son adımı Marshall B. Rosenberg\'in Şiddetsiz İletişim yaklaşımından, oyundaki ortak öğrenme ise Lev Vygotsky\'nin gelişim kuramından yararlanır. Duygu adlandırma (affect labeling) araştırmaları da bir duyguyu yalnızca adlandırmanın beyni yatıştırdığını gösteriyor; Duygu Çarkı\'ndaki her tur tam olarak bunu pekiştirir.',
        linkHref: `${base}tr/wissenschaftlicher-hintergrund`,
        linkLabel: 'Bilimsel arka plan hakkında daha fazlası',
      },
      {
        title: 'Okullardan sık sorulan sorular',
        body: `
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Müfredatımıza uyuyor mu, yoksa ek bir etkinlik mi?</strong><br />Yubuu'nun Duygu Çarkı müfredatın yerini almaz, onu tamamlar. Sınıf toplantılarına, boş ders saatlerine ya da destek saatlerine sığar; bunun için ayrıca ders süresi ayırmanız gerekmez.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Yalnızca küçük gruplarda değil, tüm sınıfla da işe yarar mı?</strong><br />Oyun başlangıçta altı çocuğa kadar küçük gruplar için tasarlandı. Tüm sınıfla kullanmak için aynı anda birkaç küçük grubun oynamasını ya da oyunu sınıf toplantısında sırayla kullanmayı öneriyoruz.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Oyunu sınıf toplantısında kullanabilir miyim?</strong><br />Evet. Sınıf toplantısı, tek tek oyun aşamalarını ya da tam turları birlikte oynamak için özellikle uygundur.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Oyun malzemelerinden yalnızca bazılarını kullanabilir miyim?</strong><br />Evet. Zamana ve hedefe göre Duygu Çarkı'nı, blitz kartlarını ya da durum kartlarını birbirinden bağımsız olarak da kullanabilirsiniz.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Oyun, özel destek ihtiyacı olan çocuklar için de uygun mu?</strong><br />Evet. Zaman baskısı ve doğru ya da yanlış cevap olmadan işlediği için özel eğitim okullarında ve bireysel destekte sık kullanılıyor.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Etkisine dair bilimsel kanıt var mı?</strong><br />Kavram, sosyal ve duygusal öğrenmeye dair köklü araştırmalara dayanıyor; bunların arasında 270.000'den fazla çocuğu kapsayan Durlak ve arkadaşlarının meta-analizi de var. Yubuu'nun Duygu Çarkı'nın kendisine yönelik etki çalışmaları 2027'den itibaren pilot aşama için planlandı.</p>
          <p class="mb-4"><strong class="text-[var(--color-ink)]">Maliyeti kim karşılıyor, destek imkânları var mı?</strong><br />Birçok okul Yubuu'nun Duygu Çarkı'nı mevcut materyal bütçelerinden ya da eğitim destek fonlarından karşılıyor. Okullar için şu anda uygun destek programlarını inceliyoruz.</p>
          <p><strong class="text-[var(--color-ink)]">Oyunu kullanmak için eğitim almam gerekir mi?</strong><br />Hayır, oyun ek bir eğitim olmadan hemen kullanılabilir. İsterseniz ek olarak bir tanıtım atölyesine de katılabilirsiniz.</p>
        `,
      },
    ]}
  />

  <div class="mx-auto max-w-3xl px-6 pb-8 text-center">
    <p class="font-serif-heading text-xl italic text-[var(--color-ink)] sm:text-2xl">Çocuklar yalnızca ne öğrendiklerini değil, öğrenirken neler hissettiklerini de hatırlar.</p>
  </div>

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <a href={`${base}tr/contact`} class="inline-block rounded-[var(--radius-pill)] bg-[var(--color-terracotta)] px-8 py-3.5 font-[var(--font-body)] font-semibold text-white shadow-[var(--shadow-soft)] transition hover:bg-[var(--color-terracotta-deep)]">Okulunuz için bilgi talep edin</a>
  </div>
</Base>
