---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/rubik';
import '../../styles/global.css';

const base = import.meta.env.BASE_URL; // e.g. "/emoria/"

// Fixed left-to-right order. Exactly one is open; the rest are vertical strips
// sitting in their positional order (earlier = left of open, later = right).
const panels = [
  {
    id: 'home', tab: 'EMORIA', strip: '#2b2a28', bg: '#fff1e4', c: '#ff7673', ink: '#2b2a28',
    kind: 'home',
    eyebrow: '✦ Duyguları anlamak. Sohbetleri başlatmak. Çocukları güçlendirmek.',
    title: "EMORIA'ya Hoş Geldiniz",
    body: 'Çocukların duygularını tanımasına, adlandırmasına ve bunlar hakkında konuşmasına yardımcı olan küçük bir evren.',
  },
  {
    id: 'meet', tab: "Yubuu'yu Tanı", strip: '#02ae90', bg: '#eaf4ef', c: '#02ae90', ink: '#08312a',
    kind: 'story', storyMode: 'meet',
    beats: [
      'Merhaba! Ben Yubuu.',
      'Duygular hakkında sık sık konuştuğumuz küçük bir gezegenden geliyorum.',
      'Ama başka dünyalardaki çocukların duyguları nasıl yaşadığını merak ettim.',
      'Bu yüzden EMORIA evreninde yolculuk ediyorum.',
      'Çok meraklıyımdır, bir sürü soru sorarım ve dikkatle dinlerim.',
      'Kimseyi yargılamam, çünkü her duygunun bir nedeni olduğuna inanırım.',
      'Bu yüzden en çok, karşılaştığım çocuklarla birlikte öğrenmeyi severim.',
      'Benimle yolculuğa çıkar mısın?',
    ],
  },
  {
    id: 'wheel', tab: "Yubuu'nun Duygu Çarkı", strip: '#ff7673', bg: '#fff1e4', c: '#ff7673', ink: '#4a1f1d',
    kind: 'game', game: 'game/index.html',
    cta: 'Oyunu Keşfet',
    beats: [
      'Merhaba, yine buradayım!',
      'Oyunu denemek ister misin?',
      'Hadi birlikte duygu dünyanı keşfedelim.',
    ],
  },
  {
    id: 'why', tab: 'Neden EMORIA?', strip: '#ea9f0e', bg: '#fae6bf', c: '#ea9f0e', ink: '#3d2a04',
    kind: 'why',
    eyebrow: 'Arkasındaki fikir',
    title: 'Neden EMORIA?',
    body: 'Duygular hakkında konuşmak öğrenilebilir bir beceridir — ve çocuklar bunu pratik yapabilecekleri güvenli bir alan bulmakta nadiren şanslıdır. EMORIA duygusal öğrenmeyi bir oyuna dönüştürür: doğru ya da yanlış cevap yoktur, on yıllık pratik ve güncel araştırmalara dayanır. Bir çocuk ne hissettiğini adlandırabildiğinde, geri kalan her şey kolaylaşır — arkadaşlıklar, odaklanma, dayanıklılık.',
  },
];
---

<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EMORIA — Duygusal Öğrenme</title>
  <meta name="description" content="EMORIA, çocukların duygularını tanımasına, adlandırmasına ve bunlar hakkında konuşmasına yardımcı olan oyun tabanlı bir sistemdir. Yubuu'nun Duygu Çarkı başlangıcı." />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href={`${base}img/logo.png`} />
  <meta property="og:title" content="EMORIA — Duygusal Öğrenme" />
  <meta property="og:description" content="Çocukların duygularını tanıması, adlandırması ve bunlar hakkında konuşması için oyun tabanlı bir yol." />
  <meta property="og:type" content="website" />
</head>
<body>
  <!-- INTRO SPLASH — plays once before the homepage. -->
  <div class="intro" id="intro" data-intro>
    <video class="intro-video" autoplay muted playsinline preload="auto" aria-label="Yubuu Dünya'ya uçuyor">
      <source src={`${base}video/intro-yubuu-earth.webm`} type="video/webm" />
      <source src={`${base}video/intro-yubuu-earth.mp4`} type="video/mp4" />
    </video>
    <button type="button" class="intro-skip" data-intro-skip>Geç</button>
  </div>

  <!-- TOP MENU -->
  <!-- TOP MENU — two tiers: a quiet utility row, and the audience tabs below it -->
  <header class="topbar" data-topbar style="left:0;right:calc(3 * var(--stripw))">
    <div class="topbar-row">
      <button class="brand" data-open="home" aria-label="Başa dön"><span class="brand-name">EMORIA</span><span class="brand-sub">Social and Emotional Learning</span></button>
      <nav class="topnav">
        <div class="aud-switch">
          <button type="button" class="aud-trigger" aria-haspopup="true" aria-expanded="false">Hedef kitle
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </button>
          <ul class="aud-menu">
            <li><a href={`${base}tr/fuer-kindergaerten`}><img src={`${base}img/audience-kindergarten.png`} alt="" aria-hidden="true" /><span>Anaokulu</span></a></li>
            <li><a href={`${base}tr/fuer-schulen`}><img src={`${base}img/audience-schule.png`} alt="" aria-hidden="true" /><span>Okul</span></a></li>
            <li><a href={`${base}tr/fuer-eltern`}><img src={`${base}img/audience-eltern.png`} alt="" aria-hidden="true" /><span>Aileler</span></a></li>
          </ul>
        </div>
        <a href={`${base}tr/about`}>Hakkımızda</a>
        <a href={`${base}tr/contact`}>İletişim</a>
        <div class="lang-switch">
          <button type="button" class="lang-trigger" aria-label="Dil seçin">🌐 TR</button>
        <ul class="lang-menu">
          <li><a href={`${base}?nointro=1`}>Deutsch <span>DE</span></a></li>
          <li><a href={`${base}en/`}>English <span>EN</span></a></li>
          <li><a href={`${base}fr/`}>Français <span>FR</span></a></li>
          <li class="disabled" title="Yakında">Español <span>ES</span></li>
          <li><a href={`${base}tr/`}>Türkçe <span>TR</span></a></li>
          <li class="disabled" title="Yakında">Dansk <span>DA</span></li>
          <li class="disabled" title="Yakında">Svenska <span>SV</span></li>
          <li class="disabled" title="Yakında">Norsk <span>NO</span></li>
          <li class="disabled" title="Yakında">Suomi <span>FI</span></li>
        </ul>
        </div>
      </nav>
    </div>
  </header>

  <div class="rail" data-rail>
    {panels.map((p, i) => (
      <section class="panel" class:list={[{ 'is-open': i === 0 }]} data-panel={p.id}
        style={`--strip:${p.strip};--bg:${p.bg};--c:${p.c};--ink:${p.ink}`}>

        <!-- collapsed strip -->
        <button class="strip" data-open={p.id} aria-label={p.tab}><span>{p.tab}</span></button>

        <!-- expanded content -->
        <div class="content">
          {p.kind === 'game' ? (
            <div class="wheelstage" data-wheelstage>
              <div class="story wheel-intro" data-story data-story-mode="wheel-intro">
                <div class="story-char">
                  <video class="story-video" style="--bh:.873;--cx:.50;--bo:.069" muted playsinline preload="auto" aria-label="Yubuu sallayarak beliriyor" data-story-video>
                    <source src={`${base}video/yubuu-wheel-nobg.webm`} type="video/webm" />
                    <source src={`${base}video/yubuu-wheel-nobg.mov`} type="video/quicktime" />
                  </video>
                </div>
                <div class="story-dialogue">
                  <div class="bubble">
                    {p.beats.map((bt, i) => (
                      <p class="bubble-line" data-beat={i}>{bt}</p>
                    ))}
                  </div>
                  <button type="button" class="p-cta wheel-cta" data-wheel-start>{p.cta}</button>
                </div>
              </div>
              <iframe class="game-frame" data-wheel-frame src={`${base}${p.game}`} title="Yubuu'nun Duygu Çarkı" loading="lazy"></iframe>
            </div>
          ) : p.kind === 'story' ? (
            <div class="story" data-story data-story-mode={p.storyMode}>
              <div class="story-char">
                <video class="story-video" style="--bh:.823;--cx:.49;--bo:.067" muted playsinline preload="auto" aria-label="Yubuu el sallayarak giriyor" data-story-video>
                  <source src={`${base}video/yubuu-wave-nobg.webm`} type="video/webm" />
                  <source src={`${base}video/yubuu-wave-nobg.mov`} type="video/quicktime" />
                </video>
              </div>
              <div class="story-dialogue">
                <div class="bubble">
                  {p.beats.map((bt, i) => (
                    <p class="bubble-line" data-beat={i}>{bt}</p>
                  ))}
                </div>
                <p class="s-hint" data-hint>Devam etmek için tıkla ya da kaydır →</p>
              </div>
            </div>
          ) : p.kind === 'why' ? (
            <div class="why">
              <img class="why-yubuu" src={`${base}img/yubuu-rocket.png`} alt="Yubuu pointing" />
              <div class="why-text">
                <h2 class="why-hero">{p.title}</h2>
                <p class="why-body">{p.body}</p>
                <div class="why-links">
                  <a href={`${base}tr/about`}>Hakkımızda →</a>
                  <a href={`${base}tr/contact`}>İletişime geç →</a>
                </div>
              </div>
            </div>
          ) : p.kind === 'home' ? (
            <div class="home-wrap">
              <div class="starfield" aria-hidden="true">
                <span class="star s1">✦</span><span class="star s2">✦</span><span class="star s3">✦</span>
                <span class="star s4">✦</span><span class="star s5">✦</span><span class="star s6">✦</span>
                <span class="star s7">✦</span><span class="star s8">✦</span><span class="star s9">✦</span>
                <span class="star s10">✦</span><span class="star s11">✦</span><span class="star s12">✦</span>
                <span class="star s13">✦</span><span class="star s14">✦</span><span class="star s15">✦</span>
                <span class="star s16">✦</span><span class="star s17">✦</span><span class="star s18">✦</span>
                <span class="star s19">✦</span><span class="star s20">✦</span><span class="star s21">✦</span>
                <span class="star s22">✦</span>
              </div>
              <div class="c-inner home">
                <div class="c-text">
                  <h1 class="home-title stg">{p.title}</h1>
                  <p class="home-sub stg">Oyunla sosyal ve duygusal eğitim.</p>
                  <p class="home-tag stg">{p.eyebrow}</p>
                </div>
                <div class="c-art home-art">
                  <div class="home-video-wrap">
                    <video class="home-video" style="--bx:.1443;--bw:.688" autoplay loop muted playsinline preload="auto" aria-label="Yubuu bir roketle uçuyor">
                      <source src={`${base}video/kling_yubuu_rocket_no-bg.webm`} type="video/webm" />
                      <source src={`${base}video/kling_yubuu_rocket_no-bg.mov`} type="video/quicktime" />
                    </video>
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <div class="c-inner">
              <div class="c-text">
                <p class="eyebrow stg">{p.eyebrow}</p>
                <h2 class="p-title stg" set:html={p.title}></h2>
                <p class="p-body stg">{p.body}</p>
                <button class="p-cta stg">{p.cta}</button>
              </div>
              <div class="c-art">
                <span class="p-planet stg"></span>
                <img class="art-yubuu stg" src={`${base}img/yubuu-rocket.png`} alt="Yubuu" />
              </div>
            </div>
          )}
        </div>
      </section>
    ))}
  </div>

  <script is:inline>
    (() => {
      const rail = document.querySelector('[data-rail]');
      const topbar = document.querySelector('[data-topbar]');
      const panels = [...rail.querySelectorAll('.panel')];
      const n = panels.length;

      const ARRIVAL_DELAY_MS = 3000;

      document.querySelectorAll('[data-story-video]').forEach((vid) => {
        vid.addEventListener('ended', () => vid.classList.add('is-idle'));
      });

      const armRevealByPanel = new WeakMap();

      function playPanelVideo(panel) {
        const vid = panel.querySelector('[data-story-video]');
        if (vid) {
          vid.classList.remove('is-idle');
          vid.currentTime = 0;
          vid.play().catch(() => {});
        }
        armRevealByPanel.get(panel)?.();
      }

      function setOpen(id) {
        const idx = panels.findIndex((p) => p.dataset.panel === id);
        if (idx < 0) return;
        panels.forEach((p, i) => p.classList.toggle('is-open', i === idx));
        topbar.style.left = `calc(${idx} * var(--stripw))`;
        topbar.style.right = `calc(${n - 1 - idx} * var(--stripw))`;
        playPanelVideo(panels[idx]);
      }

      document.querySelectorAll('[data-open]').forEach((btn) =>
        btn.addEventListener('click', () => setOpen(btn.dataset.open)));

      document.querySelectorAll('[data-story]').forEach((story) => {
        const panel = story.closest('.panel');
        const mode = story.dataset.storyMode;
        const bubble = story.querySelector('.bubble');
        const beats = [...story.querySelectorAll('.bubble-line')];
        const hint = story.querySelector('[data-hint]');
        const ctaBtn = story.querySelector('[data-wheel-start]');
        const last = beats.length - 1;
        let idx = 0;
        let revealed = false;
        let revealTimer = null;
        const isOpen = () => panel.classList.contains('is-open');

        function show(i) {
          i = Math.max(0, Math.min(last, i));
          beats.forEach((b, k) => b.classList.toggle('is-shown', k === i));
          idx = i;
          const atLast = idx >= last;
          if (hint) {
            hint.classList.toggle('hide', atLast && mode !== 'meet');
            hint.textContent = idx === 0
              ? 'Devam etmek için tıkla ya da kaydır →'
              : (mode === 'meet' && atLast ? "Duygu Çarkı'na geç →" : 'Devam →');
          }
          if (ctaBtn) ctaBtn.classList.toggle('is-shown', atLast);
        }

        function armReveal() {
          revealed = false;
          idx = 0;
          bubble.classList.remove('is-visible');
          beats.forEach((b) => b.classList.remove('is-shown'));
          if (hint) hint.classList.add('hide');
          if (ctaBtn) ctaBtn.classList.remove('is-shown');
          clearTimeout(revealTimer);
          revealTimer = setTimeout(() => {
            revealed = true;
            bubble.classList.add('is-visible');
            show(0);
          }, ARRIVAL_DELAY_MS);
        }
        armRevealByPanel.set(panel, armReveal);

        story.addEventListener('click', (e) => {
          if (!isOpen() || !revealed || e.target.closest('[data-wheel-start]')) return;
          if (mode === 'meet' && idx >= last) { setOpen('wheel'); return; }
          show(idx + 1);
        });

        let lock = 0;
        story.addEventListener('wheel', (e) => {
          if (!isOpen() || !revealed) return;
          e.preventDefault();
          if (Math.abs(e.deltaY) < 8 || e.timeStamp - lock < 600) return;
          lock = e.timeStamp;
          if (mode === 'meet' && idx >= last && e.deltaY > 0) { setOpen('wheel'); return; }
          show(e.deltaY > 0 ? idx + 1 : idx - 1);
        }, { passive: false });
      });

      setOpen('home');

      document.querySelectorAll('[data-wheel-start]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          btn.closest('[data-wheelstage]')?.classList.add('is-playing');
        });
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const intro = document.querySelector('[data-intro]');
      if (!intro) return;
      const video = intro.querySelector('video');
      const skip = intro.querySelector('[data-intro-skip]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const skipIntro = new URLSearchParams(location.search).has('nointro');
      let alreadySeen = false;
      try { alreadySeen = localStorage.getItem('emoria-intro-seen') === '1'; } catch {}
      let done = false;

      function finish() {
        if (done) return;
        done = true;
        intro.classList.add('is-handoff');
        setTimeout(() => {
          intro.classList.add('is-hidden');
          setTimeout(() => intro.remove(), 650);
        }, 550);
      }

      if (reduceMotion || skipIntro || alreadySeen || !video) { intro.remove(); return; }
      try { localStorage.setItem('emoria-intro-seen', '1'); } catch {}
      video.addEventListener('ended', finish);
      video.addEventListener('error', finish);
      skip.addEventListener('click', finish);
      setTimeout(finish, 14000);
    })();
  </script>

  <style is:global>
    :root { --stripw: 4.75rem; }
    html, body { margin: 0; overflow-x: hidden; max-width: 100%; }
    a, button { -webkit-tap-highlight-color: transparent; }
    a:focus-visible, button:focus-visible { outline: 3px solid #2b2a28; outline-offset: 2px; }

    .intro { position: fixed; inset: 0; z-index: 100; background: #0b1026;
      display: flex; align-items: center; justify-content: center; overflow: hidden;
      opacity: 1; transition: opacity .6s ease, background-color .7s ease; }
    .intro.is-handoff { background-color: #fff1e4; }
    .intro.is-hidden { opacity: 0; pointer-events: none; }
    .intro-video { width: 100%; height: 100%; object-fit: cover; display: block;
      transition: opacity .55s ease; }
    .intro.is-handoff .intro-video { opacity: 0; }
    .intro-skip { position: absolute; right: clamp(1rem, 3vw, 2rem); bottom: clamp(1rem, 3vw, 2rem);
      z-index: 1; border: 1px solid rgba(255,255,255,.5); background: rgba(11,16,38,.35);
      color: #fff; font-family: 'Rubik Variable', sans-serif; font-weight: 500; font-size: 14px;
      padding: .55rem 1.1rem; border-radius: 999px; cursor: pointer; backdrop-filter: blur(2px);
      transition: background .2s ease, opacity .3s ease; }
    .intro-skip:hover { background: rgba(11,16,38,.55); }
    .intro.is-handoff .intro-skip { opacity: 0; pointer-events: none; }
    @media (prefers-reduced-motion: reduce) { .intro { display: none; } }

    /* TOP MENU — two tiers: quiet utility row, then the audience tabs */
    .topbar { position: fixed; top: 0; z-index: 40; display: flex; flex-direction: column;
      padding: 10px clamp(1.2rem, 2.6vw, 2.2rem) 0;
      transition: left .62s cubic-bezier(.72,0,.14,1), right .62s cubic-bezier(.72,0,.14,1); }
    .topbar-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .brand { background: none; border: 0; cursor: pointer; color: #2b2a28; padding: 0;
      display: flex; flex-direction: column; align-items: flex-start; line-height: 1.05; text-align: left; }
    .brand-name { font-family: 'Fredoka Variable', sans-serif; font-weight: 600; font-size: 22px; letter-spacing: .02em; }
    .brand-sub { font-family: 'Rubik Variable', sans-serif; font-weight: 500; font-size: 10.5px;
      letter-spacing: .07em; text-transform: uppercase; color: #8a8378; margin-top: 3px; white-space: nowrap; }

    /* secondary links — deliberately quieter than the audience tabs */
    .topnav { display: flex; align-items: center; gap: 1rem; }
    .topnav a { font-family: 'Rubik Variable', sans-serif; font-weight: 500; font-size: 13px;
      color: #2b2a28; text-decoration: none; opacity: .78; transition: opacity .2s, border-color .2s;
      display: inline-flex; align-items: center; min-height: 34px;
      border-bottom: 2px solid rgba(255,118,115,.55); padding-bottom: 1px; }
    .topnav a:hover { opacity: 1; border-bottom-color: #ff7673; }
    .lang-switch { position: relative; }
    .lang-trigger { background: none; border: 0; cursor: pointer; font-family: 'Rubik Variable', sans-serif;
      font-weight: 500; font-size: 13px; color: #2b2a28; opacity: .7; transition: opacity .2s;
      min-height: 34px; padding: 0; }
    .lang-trigger:hover { opacity: 1; }
    .lang-menu { position: absolute; right: 0; top: calc(100% + 8px); z-index: 10; margin: 0;
      list-style: none; width: 10.5rem; padding: .4rem; border-radius: 14px;
      background: #fff; border: 1px solid #ecdcc4; box-shadow: 0 20px 48px rgba(43,42,40,.12);
      opacity: 0; visibility: hidden; transform: translateY(-4px);
      transition: opacity .18s ease, transform .18s ease, visibility .18s; }
    .lang-switch:hover .lang-menu, .lang-switch:focus-within .lang-menu {
      opacity: 1; visibility: visible; transform: none; }
    .lang-menu li { display: flex; align-items: center; justify-content: space-between;
      padding: .5rem .7rem; border-radius: 8px; font-family: 'Rubik Variable', sans-serif; font-size: 14px; }
    .lang-menu li span { color: #a89f8f; }
    .lang-menu a { display: flex; width: 100%; align-items: center; justify-content: space-between;
      color: #2b2a28; text-decoration: none; }
    .lang-menu li:not(.disabled):hover { background: #fff1e4; }
    .lang-menu li.disabled { color: #a89f8f; cursor: not-allowed; }

    /* ---- Zielgruppe: one entry that drops the audience pages down on hover ---- */
    .aud-switch { position: relative; }
    .aud-trigger { display: inline-flex; align-items: center; gap: 5px; background: none; border: 0;
      border-bottom: 2px solid rgba(255,118,115,.55); padding: 0 0 1px; cursor: pointer;
      font-family: 'Rubik Variable', sans-serif; font-weight: 500; font-size: 13px; color: #2b2a28;
      opacity: .78; min-height: 34px; transition: opacity .2s, border-color .2s; }
    .aud-switch:hover .aud-trigger { opacity: 1; border-bottom-color: #ff7673; }
    .aud-menu { position: absolute; left: 50%; transform: translate(-50%, -4px); top: calc(100% + 8px);
      z-index: 10; margin: 0; list-style: none; width: 15rem; padding: .4rem; border-radius: 16px;
      background: #fff; border: 1px solid #ecdcc4; box-shadow: 0 20px 48px rgba(43,42,40,.16);
      opacity: 0; visibility: hidden;
      transition: opacity .18s ease, transform .18s ease, visibility .18s; }
    .aud-switch:hover .aud-menu, .aud-switch:focus-within .aud-menu {
      opacity: 1; visibility: visible; transform: translate(-50%, 0); }
    .aud-menu li { display: block; }
    .aud-menu a { display: flex; align-items: center; gap: .65rem; padding: .45rem .55rem;
      border-radius: 11px; text-decoration: none; color: #2b2a28;
      font-family: 'Rubik Variable', sans-serif; font-size: 14px; font-weight: 500; }
    .aud-menu a:hover { background: #fff1e4; }
    .aud-menu img { width: 34px; height: 34px; border-radius: 10px; object-fit: cover; flex: none;
      box-shadow: 0 1px 4px rgba(43,42,40,.18); }

    @media (max-width: 768px) {
      /* the rail's colour strips run full height behind the header, so on phones
         the bar becomes an opaque sheet instead of floating over them */
      .topbar { left: 0 !important; right: 0 !important; padding: 8px .8rem 0;
        background: #fff8ef; box-shadow: 0 2px 10px rgba(43,42,40,.08); }
      .brand { font-size: 18px; }
      /* the tagline may wrap here — the links need the room more than it does */
      .brand-sub { font-size: 8.5px; letter-spacing: .04em; white-space: normal; max-width: 15ch; }
      .topnav { gap: .7rem; }
      .topnav a, .lang-trigger { font-size: 11.5px; min-height: 30px; }
      .aud-trigger { font-size: 11.5px; min-height: 30px; }
      .aud-menu { width: 13.5rem; }
    }
    @media (max-width: 380px) {
      .aud-txt b { font-size: 11px; }
      /* on the narrowest phones the four links would wrap onto two lines —
         shrink them and keep each one on a single line instead */
      .topnav { gap: .5rem; }
      .topnav a, .lang-trigger { font-size: 10.5px; white-space: nowrap; }
      .brand { font-size: 16px; }
      .topbar { padding-inline: .6rem; }
    }

    .rail { display: flex; height: 100vh; width: 100vw; overflow: hidden; background: #fff1e4;
      font-family: 'Rubik Variable', sans-serif; }

    .panel { position: relative; flex: 0 0 auto; width: var(--stripw);
      transition: width .62s cubic-bezier(.72,0,.14,1); overflow: hidden; }
    .panel.is-open { width: calc(100vw - (3 * var(--stripw))); }

    .strip { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; border: 0; cursor: pointer;
      background: var(--strip); color: #fff; font-family: 'Fredoka Variable', sans-serif; font-weight: 600;
      font-size: 18px; letter-spacing: .01em; display: flex; align-items: center; justify-content: center;
      writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg);
      transition: opacity .35s ease, filter .3s ease; white-space: nowrap; }
    .strip:hover { filter: brightness(1.08); }
    .panel.is-open .strip { opacity: 0; pointer-events: none; }

    .content { position: absolute; top: 0; left: 0; height: 100%; width: calc(100vw - (3 * var(--stripw)));
      background: var(--bg); opacity: 0; pointer-events: none; transition: opacity .3s ease;
      overflow: hidden; /* never let text/art bleed under the collapsed strips */ }
    .panel.is-open .content { opacity: 1; pointer-events: auto; transition-delay: .18s; }
    .game-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
      padding-top: 74px; box-sizing: border-box; background: #fff1e4; }

    .wheelstage { position: absolute; inset: 0; }
    .wheel-intro { opacity: 1; transition: opacity .4s ease; }
    .wheelstage .game-frame { opacity: 0; pointer-events: none; transition: opacity .4s ease; }
    .wheelstage.is-playing .wheel-intro { opacity: 0; pointer-events: none; }
    .wheelstage.is-playing .game-frame { opacity: 1; pointer-events: auto; }
    .wheel-cta { opacity: 0; transform: translateY(10px); pointer-events: none;
      transition: opacity .4s ease, transform .4s ease; }
    .wheel-cta.is-shown { opacity: 1; transform: none; pointer-events: auto; }

    .story { position: absolute; inset: 0; overflow: hidden; cursor: pointer;
      padding: 92px 6vw 2vh; display: grid; grid-template-columns: .85fr 1.15fr;
      align-items: stretch; gap: 3vw; }
    /* no overflow clipping here: the frame around Yubuu is transparent, and the
       panel itself already clips at its edge — so a wide gesture (arms out) can
       never be cut off mid-animation */
    .story-char { position: relative; height: 82%; align-self: end; }
    /* Yubuu only fills part of the source frame, with empty space all around
       him. Rather than blowing the whole frame up and letting the box cut the
       overflow (which sliced his antennae off), each video carries its own
       measured bounds — --bh is how much of the frame's height he spans,
       --cx where his centre sits across it, --bo the gap under his feet — and
       those bounds are mapped onto the box. He fills it top to bottom, and
       nothing of him can fall outside it. */
    .story-video { position: absolute; left: 50%; bottom: calc(-100% * var(--bo) / var(--bh));
      height: calc(100% / var(--bh)); width: auto; max-width: none;
      transform: translateX(calc(var(--cx) * -100%)); pointer-events: none; z-index: 1;
      filter: drop-shadow(0 18px 30px rgba(43,42,40,.16)); }
    .story-video.is-idle { animation: idleBlink 4.6s ease-in-out infinite; }
    @keyframes idleBlink {
      0%, 94%, 100% { filter: drop-shadow(0 18px 30px rgba(43,42,40,.16)) brightness(1); }
      96% { filter: drop-shadow(0 18px 30px rgba(43,42,40,.16)) brightness(.82); }
      98% { filter: drop-shadow(0 18px 30px rgba(43,42,40,.16)) brightness(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .story-video.is-idle { animation: none; }
    }
    .story-dialogue { display: flex; flex-direction: column; gap: 1.1rem;
      align-self: start; margin-top: 15vh; position: relative; z-index: 2; }
    .bubble { position: relative; max-width: 34rem;
      background: color-mix(in srgb, var(--c) 30%, #fff 70%);
      border: 3px solid color-mix(in srgb, var(--c) 55%, #fff 45%);
      border-radius: 26px; padding: 1.6rem 1.9rem; box-shadow: 0 10px 28px rgba(43,42,40,.10);
      opacity: 0; transform: scale(.6); transform-origin: 14% 100%; pointer-events: none; }
    .bubble.is-visible { opacity: 1; transform: none; pointer-events: auto;
      animation: bubblePop .5s cubic-bezier(.34, 1.56, .64, 1); }
    .bubble::before { content: ''; position: absolute; left: 34px; bottom: -13px;
      width: 24px; height: 24px; background: color-mix(in srgb, var(--c) 30%, #fff 70%);
      border-right: 3px solid color-mix(in srgb, var(--c) 55%, #fff 45%);
      border-bottom: 3px solid color-mix(in srgb, var(--c) 55%, #fff 45%);
      border-radius: 0 0 6px 0; transform: rotate(45deg); }
    @keyframes bubblePop {
      0% { opacity: 0; transform: scale(.5); }
      55% { opacity: 1; transform: scale(1.08); }
      80% { transform: scale(.96); }
      100% { transform: scale(1); }
    }
    .bubble-line { display: none; margin: 0; font-family: 'Fredoka Variable', sans-serif;
      font-weight: 500; font-size: clamp(19px, 2vw, 26px); line-height: 1.34; color: var(--ink); }
    .bubble-line.is-shown { display: block; animation: bubbleIn .4s cubic-bezier(.34, 1.56, .64, 1); }
    @keyframes bubbleIn { 0% { opacity: 0; transform: scale(.85) translateY(6px); }
      60% { opacity: 1; transform: scale(1.04) translateY(-1px); } 100% { transform: none; } }
    .s-hint { font-family: 'Rubik Variable', sans-serif; font-size: 14px; color: #8a8378;
      margin: 0; white-space: nowrap; animation: hintpulse 1.9s ease-in-out infinite; }
    .s-hint.hide { animation: none; opacity: 0; transition: opacity .4s; }
    @keyframes hintpulse { 0%,100% { opacity: .55; } 50% { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) {
      .bubble-line.is-shown, .bubble.is-visible { animation: none; }
    }
    @media (max-width: 820px) {
      .story { grid-template-columns: 1fr; padding-top: 92px; display: flex;
        flex-direction: column; justify-content: center; align-items: stretch; }
      .story-char { display: none; }
      .story-dialogue { margin-top: 0; }
      .bubble::before { display: none; }
      .bubble-line { font-size: clamp(18px, 5vw, 24px); }
    }

    .why { position: absolute; inset: 0; }
    .why-yubuu { position: absolute; left: 3%; bottom: 8%; width: min(32%, 460px); height: auto;
      max-width: none; z-index: 1; pointer-events: none;
      filter: drop-shadow(0 22px 34px rgba(43,42,40,.20)); }
    .why-text { position: absolute; right: 8.5%; top: 0; bottom: 0; width: 52%;
      display: flex; flex-direction: column; justify-content: flex-start; padding-top: 13vh; z-index: 2; }
    .why-eyebrow { font-family: 'Rubik Variable', sans-serif; font-weight: 600; letter-spacing: .14em;
      text-transform: uppercase; font-size: 13px; color: var(--c); }
    .why-hero { font-family: 'Fredoka Variable', sans-serif; font-weight: 600;
      font-size: clamp(46px, 6vw, 88px); line-height: 1; color: var(--ink); margin: .12em 0 .34em; }
    .why-body { font-family: 'Rubik Variable', sans-serif; font-size: clamp(18px, 1.65vw, 23px);
      line-height: 1.55; color: var(--ink); opacity: .86; max-width: 46ch; }
    .why-links { margin-top: 1.9rem; display: flex; gap: 1.6rem; flex-wrap: wrap; }
    .why-links a { font-family: 'Fredoka Variable', sans-serif; font-weight: 600; font-size: 16px;
      color: var(--c); text-decoration: none; filter: brightness(.85); }
    .why-links a:hover { text-decoration: underline; }
    @media (max-width: 1100px) {
      .why-yubuu { display: none; }
      .why-text { width: 86%; right: 6%; padding-top: 15vh; }
    }
    @media (max-width: 768px) {
      .why-text { width: 90%; right: 5%; padding-top: 18vh; }
      .why-hero { font-size: clamp(32px, 9vw, 52px); }
      .why-body { font-size: 16px; max-width: none; }
    }

    .c-inner { height: 100%; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center;
      gap: 3vw; padding: 0 5.5vw; }
    .c-inner.home { grid-template-columns: 0.9fr 1.1fr; }

    .eyebrow { font-weight: 600; letter-spacing: .12em; text-transform: uppercase; font-size: 13px; color: var(--c); }
    .home-title { font-family: 'Fredoka Variable', sans-serif; font-weight: 600; font-size: clamp(40px, 5.1vw, 78px); line-height: .98; color: var(--ink); margin: .1em 0 .3em; }
    .home-tag { font-family: 'Rubik Variable', sans-serif; font-weight: 600; font-size: clamp(15px, 1.5vw, 20px); letter-spacing: .04em; color: var(--c); margin: 0 0 .8em; }
    .home-sub { font-size: 16px; line-height: 1.6; color: #57534c; max-width: 26rem; margin: 0 0 .6em; }
    .p-title { font-family: 'Fredoka Variable', sans-serif; font-weight: 600; font-size: clamp(34px, 4.6vw, 62px); line-height: 1.03; color: var(--ink); margin: .22em 0; }
    .p-body { font-size: 18px; line-height: 1.6; color: var(--ink); opacity: .82; max-width: 26rem; }
    .p-cta { margin-top: 1.6rem; border: 0; cursor: pointer; background: var(--c); color: #fff;
      font-family: 'Fredoka Variable', sans-serif; font-weight: 600; font-size: 16px; padding: .8rem 1.7rem; border-radius: 999px; }

    .c-art { position: relative; height: 62%; }
    .home-art { height: 100%; display: flex; align-items: center; justify-content: center; }
    .home-video-wrap { width: min(80%, 440px); transform: translateX(-135vw); opacity: 0; will-change: transform; }
    .panel.is-open .home-video-wrap { animation: flyIn 1.15s cubic-bezier(.16,.7,.24,1) 1.2s forwards; }
    /* same idea as the story videos: the rocket only covers part of its frame,
       so it is sized and nudged by its own measured bounds instead of leaving
       a wide transparent margin around it */
    .home-video { display: block; width: calc(100% / var(--bw)); max-width: none;
      margin-left: calc(-100% * var(--bx) / var(--bw)); height: auto;
      filter: drop-shadow(0 24px 34px rgba(43,42,40,.16)); animation: hfloat 6s ease-in-out infinite; }
    @keyframes hfloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-16px); } }
    @keyframes flyIn { 0% { transform: translateX(-135vw) rotate(-8deg); opacity: 0; }
      55% { opacity: 1; } 100% { transform: translateX(0) rotate(0); opacity: 1; } }
    @media (prefers-reduced-motion: reduce) {
      .home-video { animation: none; }
      .home-video-wrap, .panel.is-open .home-video-wrap { animation: none; transform: none; opacity: 1; }
    }
    .art-yubuu { position: absolute; bottom: -16%; left: 50%; transform: translateX(-50%); height: 128%;
      filter: drop-shadow(0 18px 30px rgba(43,42,40,.18)); }
    .art-yubuu.point { height: 118%; }
    .p-planet { position: absolute; top: 4%; right: 8%; width: 88px; height: 88px; border-radius: 50%;
      background: radial-gradient(circle at 38% 32%, #fff, color-mix(in srgb, var(--c) 55%, #fff) 55%, var(--c));
      box-shadow: 0 12px 30px rgba(0,0,0,.12); }
    .home-wrap { position: absolute; inset: 0; }
    .starfield { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .c-inner.home { position: relative; z-index: 1; }
    .star { position: absolute; color: var(--c); line-height: 1;
      animation: twinkle 3.4s ease-in-out infinite; }
    @keyframes twinkle { 0%,100% { opacity: .22; transform: scale(.85); }
      50% { opacity: .8; transform: scale(1.15); } }
    .starfield .star:nth-child(4n)   { animation-delay: .4s; }
    .starfield .star:nth-child(4n+1) { animation-delay: 1.1s; }
    .starfield .star:nth-child(4n+2) { animation-delay: 1.9s; }
    .starfield .star:nth-child(4n+3) { animation-delay: 2.6s; }
    .s1 { top: 7%;  left: 4%;  font-size: 22px; } .s2  { top: 14%; left: 21%; font-size: 13px; }
    .s3 { top: 6%;  left: 39%; font-size: 16px; } .s4  { top: 11%; left: 60%; font-size: 12px; }
    .s5 { top: 8%;  left: 81%; font-size: 21px; } .s6  { top: 21%; left: 92%; font-size: 14px; }
    .s7 { top: 29%; left: 11%; font-size: 15px; } .s8  { top: 39%; left: 29%; font-size: 11px; }
    .s9 { top: 33%; left: 51%; font-size: 25px; } .s10 { top: 45%; left: 73%; font-size: 13px; }
    .s11{ top: 52%; left: 90%; font-size: 17px; } .s12 { top: 59%; left: 7%;  font-size: 19px; }
    .s13{ top: 67%; left: 25%; font-size: 12px; } .s14 { top: 73%; left: 45%; font-size: 15px; }
    .s15{ top: 81%; left: 63%; font-size: 23px; } .s16 { top: 87%; left: 83%; font-size: 13px; }
    .s17{ top: 77%; left: 5%;  font-size: 14px; } .s18 { top: 90%; left: 33%; font-size: 18px; }
    .s19{ top: 46%; left: 15%; font-size: 12px; } .s20 { top: 24%; left: 45%; font-size: 14px; }
    .s21{ top: 62%; left: 54%; font-size: 12px; } .s22 { top: 84%; left: 14%; font-size: 16px; }

    .stg { opacity: 0; transform: translateY(22px); }
    .panel.is-open .stg { opacity: 1; transform: none; transition: opacity .6s ease, transform .6s cubic-bezier(.2,.7,.2,1); }
    .panel.is-open .eyebrow { transition-delay: .30s; }
    .panel.is-open .home-title, .panel.is-open .p-title { transition-delay: .38s; }
    .panel.is-open .home-sub, .panel.is-open .p-body { transition-delay: .48s; }
    .panel.is-open .home-title { transition-delay: .50s; }
    .panel.is-open .home-sub { transition-delay: .64s; }
    .panel.is-open .home-tag { transition-delay: .78s; }
    .panel.is-open .p-cta { transition-delay: .58s; }
    .panel.is-open .c-art, .panel.is-open .art-yubuu, .panel.is-open .p-planet { transition-delay: .44s; }

    @media (max-width: 820px) {
      :root { --stripw: 2.4rem; }
      .content { width: calc(100vw - (3 * var(--stripw))); }
      .c-inner, .c-inner.home { grid-template-columns: 1fr; padding: 0 6vw; }
      .c-art { display: none; }
      .strip { font-size: 12px; min-width: 44px; }
      .home-title { font-size: clamp(30px, 9vw, 56px); }
      .home-sub { font-size: 15px; }
      .p-title { font-size: clamp(26px, 8vw, 46px); }
    }
    @media (max-width: 380px) {
      :root { --stripw: 1.9rem; }
      .content { width: calc(100vw - (3 * var(--stripw))); }
    }
  </style>
</body>
</html>
