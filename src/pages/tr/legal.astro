---
import Base from '../../layouts/Base.astro';
// German-law Impressum (§5 DDG). Placeholder — the German version is legally
// authoritative; this Turkish page is a courtesy translation for visitors.
---

<Base lang="tr" title="Yasal Bilgiler — EMORIA" current=""
  description="EMORIA'nın yasal bilgileri.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-2xl px-6 pb-24 pt-36">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Yasal Bilgiler</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Yasal Bilgiler</h1>
      <p class="mt-4 rounded-[var(--radius-card)] bg-[var(--color-cream-deep)] px-4 py-3 text-sm text-[var(--color-ink-soft)]">
        Taslak — yayına girmeden önce eksiksiz bilgilerle tamamlanacaktır. Alman hukuku
        §5 DDG uyarınca eksiksiz bir yasal bildirim gerektirir; Almanca versiyon
        hukuken bağlayıcıdır.
      </p>

      <div class="mt-10 space-y-8 text-[var(--color-ink-soft)]">
        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Sağlayıcı</h2>
          <p class="mt-2">
            Cemil Can Özkaya<br />
            EMORIA<br />
            [Sokak ve numara]<br />
            [Posta kodu] Berlin<br />
            Almanya
          </p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">İletişim</h2>
          <p class="mt-2">
            E-posta: hello@emoria.de<br />
            [Telefon, opsiyonel]
          </p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">İçerikten Sorumlu</h2>
          <p class="mt-2">Cemil Can Özkaya, yukarıdaki adres.</p>
        </section>

        <section>
          <h2 class="text-xl text-[var(--color-ink)]">Görsel Kaynakları</h2>
          <p class="mt-2">İllüstrasyonlar ve ürün fotoğrafları © EMORIA. Karakter illüstrasyonları, nihai profesyonel çalışmalar hazır olana kadar taslak / yapay zeka destekli çalışmalardır.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
