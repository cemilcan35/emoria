---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL; // e.g. "/emoria/"
---

<Base title="Über EMORIA" current="Über EMORIA"
  description="EMORIA entwickelt wissenschaftlich fundierte, pädagogische Werkzeuge für emotionale Bildung. Unser erstes Produkt: Yubuus Gefühlsrad.">
  <article class="bg-[var(--color-cream)]">
    <div class="mx-auto max-w-3xl px-6 pb-14 pt-36 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-brand)]">✦ Über EMORIA</p>
      <h1 class="mt-3 text-4xl sm:text-6xl">Über EMORIA</h1>
    </div>

    <div class="mx-auto max-w-2xl space-y-6 px-6 pb-20 text-lg text-[var(--color-ink-soft)]">
      <p>
        EMORIA entwickelt wissenschaftlich fundierte, pädagogische Werkzeuge für
        emotionale Bildung. Unser erstes Produkt, Yubuus Gefühlsrad, begleitet Kinder
        von vier bis zehn Jahren dabei, Gefühle zu erkennen, zu benennen und zu
        verstehen, was dahintersteckt. Im Mittelpunkt steht Yubuu, ein neugieriges
        Wesen, das nie bewertet, sondern fragt und zuhört.
      </p>

      <img src={`${base}img/yubuu-spaceship.png`} alt="Yubuu reist durch das Universum" loading="lazy"
        class="mx-auto w-full max-w-md rounded-[1.75rem] shadow-[var(--shadow-lift)]" />

      <p>
        Yubuus Gefühlsrad ist erst der Anfang. EMORIA wächst als Universum weiter, mit
        dem Ziel, dass emotionale Bildung genauso selbstverständlich wird wie Lesen und
        Rechnen.
      </p>
    </div>

    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <img src={`${base}img/yubuu-asteroid.png`} alt="Yubuu" class="mx-auto mb-4 h-28 w-auto drop-shadow-[0_14px_20px_rgba(43,42,40,0.16)]" />
      <h2 class="text-3xl">Bring EMORIA in Ihre Kita</h2>
      <p class="mx-auto mt-4 max-w-lg text-[var(--color-ink-soft)]">
        Wenn Ihre Kita oder Praxis eine der ersten sein möchte, die EMORIA ausprobiert,
        spricht Cemil gerne mit Ihnen.
      </p>
      <a href={`${base}contact`} class="mt-7 inline-block rounded-[var(--radius-pill)] bg-[var(--color-brand)] px-8 py-3.5 font-[var(--font-body)] font-semibold text-white shadow-[var(--shadow-soft)] transition hover:bg-[var(--color-brand-deep)]">
        Kontakt aufnehmen
      </a>
    </div>
  </article>
</Base>
